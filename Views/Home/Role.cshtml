@{
    ViewData["Title"] = "Role";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Role</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Role</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<div class="app-content">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Quick Example -->
            <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <div class="card-title">Quick Example</div>
                    </div>
                    <form id="roleForm">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <input type="hidden" id="RoleID" name="RoleID" value="0" />

                            <div class="mb-3">
                                <label for="RoleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="RoleName" name="RoleName" required />
                            </div>

                            <div class="mb-3">
                                <label for="Description" class="form-label">Description</label>
                                <textarea class="form-control" id="Description" name="Description" rows="3"></textarea>
                            </div>

                        </div>
                        <div class="card-footer">
                            <button type="button" id="btnSubmit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Role List -->
            <div class="col-md-6">
                <div class="card card-info card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">Role List</h3>
                    </div>

                    <div class="card-body p-0" id="roleList">
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function() {
        LoadRoleList()
    });

    function LoadRoleList() {
        $.ajax({
            url: '@Url.Action("GetRole", "Home")',
            type: 'GET',
            success: function (response) {
                $("#roleList").html(response);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load role list.");
            }
        });
    }

    function DeleteRole(id) {
        if (!confirm('Delete role?')) return;
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        $.ajax({
            url: '@Url.Action("DeleteRole", "Home")',
            type: 'POST',
            data: { id: id },
            headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' },
            success: function (res) {
                if (res && res.success) {
                    alert(res.message);
                    LoadRoleList();
                } else {
                    alert(res && res.message ? res.message : 'Delete failed');
                }
            },
            error: function (err) { console.log(err); alert('Server error'); }
        });
    }

    function EditRole(id) {
        var model = {
            RoleID: id
        };

        $.ajax({
            url: '@Url.Action("GetRoleById", "Home")',
            type: 'GET',
            data: model,
            success: function (response) {
                // populate all editable fields (response is camel-cased JSON from ASP.NET Core)
                $("#RoleID").val(response.roleID || 0);
                $("#RoleName").val(response.roleName || '');
                $("#Description").val(response.description || '');
                // scroll to form (optional)
                window.scrollTo({ top: 0, behavior: 'smooth' });
                // change submit button to Update when editing
                $("#btnSubmit").text('Update');
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load role.");
            }
        });
    }

    $("#btnSubmit").click(function (e) {
        e.preventDefault();

        var token = $('input[name="__RequestVerificationToken"]').val();

        var roleData = {
            RoleID: parseInt($("#RoleID").val() || 0),
            RoleName: $("#RoleName").val(),
            Description: $("#Description").val()
        };

        $.ajax({
            url: '@Url.Action("Role", "Home")',
            type: 'POST',
            data: roleData,
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function (response) {
                if (response && response.success) {
                    alert(response.message);
                    $("#roleForm")[0].reset();
                    $("#RoleID").val(0);
                    // refresh the list
                    LoadRoleList();
                    // reset button text to Submit after save
                    $("#btnSubmit").text('Submit');
                } else {
                    alert(response && response.message ? response.message : "Operation failed.");
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Something went wrong!");
            }
        });

    });

</script>

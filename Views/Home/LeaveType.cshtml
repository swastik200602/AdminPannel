@{
    ViewData["Title"] = "Leave Type";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Leave Type</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Leave Type</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<div class="app-content">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Quick Example -->
            <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <div class="card-title">Quick Example</div>
                    </div>
                    <form id="leaveTypeForm">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <input type="hidden" id="LeaveTypeID" name="LeaveTypeID" value="0" />

                            <div class="mb-3">
                                <label for="LeaveTypeName" class="form-label">Leave Type Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="LeaveTypeName" name="LeaveTypeName" required />
                            </div>

                            <div class="mb-3">
                                <label for="LeaveCode" class="form-label">Leave Code <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="LeaveCode" name="LeaveCode" required />
                            </div>

                            <div class="mb-3">
                                <label for="MaxLeavesPerYear" class="form-label">Max Leaves Per Year <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" id="MaxLeavesPerYear" name="MaxLeavesPerYear" required />
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="IsPaidLeave" name="IsPaidLeave" />
                                    <label class="form-check-label" for="IsPaidLeave">Paid Leave</label>
                                </div>
                            </div>

                        </div>
                        <div class="card-footer">
                            <button type="button" id="btnSubmit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Leave Type List -->
            <div class="col-md-6">
                <div class="card card-info card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">Leave Type List</h3>
                    </div>

                    <div class="card-body p-0" id="leaveTypeList">
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

<script>
    $(document).ready(function() {
        LoadLeaveTypeList()
    });

    function LoadLeaveTypeList() {
        $.ajax({
            url: '@Url.Action("GetLeaveType", "Home")',
            type: 'GET',
            success: function (response) {
                $("#leaveTypeList").html(response);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load leave type list.");
            }
        });
    }

    function DeleteLeaveType(id) {
        if (!confirm('Delete leave type?')) return;
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        $.ajax({
            url: '@Url.Action("DeleteLeaveType", "Home")',
            type: 'POST',
            data: { id: id },
            headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' },
            success: function (res) {
                if (res && res.success) {
                    alert(res.message);
                    LoadLeaveTypeList();
                } else {
                    alert(res && res.message ? res.message : 'Delete failed');
                }
            },
            error: function (err) { console.log(err); alert('Server error'); }
        });
    }

    function EditLeaveType(id) {
        var model = {
            LeaveTypeID: id
        };

        $.ajax({
            url: '@Url.Action("GetLeaveTypeById", "Home")',
            type: 'GET',
            data: model,
            success: function (response) {
                // populate all editable fields (response is camel-cased JSON from ASP.NET Core)
                $("#LeaveTypeID").val(response.leaveTypeID || 0);
                $("#LeaveTypeName").val(response.leaveTypeName || '');
                $("#LeaveCode").val(response.leaveCode || '');
                $("#MaxLeavesPerYear").val(response.maxLeavesPerYear || 0);
                $("#IsPaidLeave").prop('checked', response.isPaidLeave || false);

                // scroll to form (optional)
                window.scrollTo({ top: 0, behavior: 'smooth' });
                // change submit button to Update when editing
                $("#btnSubmit").text('Update');
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load leave type.");
            }
        });
    }

    $("#btnSubmit").click(function (e) {
        e.preventDefault();

        var token = $('input[name="__RequestVerificationToken"]').val();

        var leaveTypeData = {
            LeaveTypeID: parseInt($("#LeaveTypeID").val() || 0),
            LeaveTypeName: $("#LeaveTypeName").val(),
            LeaveCode: $("#LeaveCode").val(),
            MaxLeavesPerYear: parseInt($("#MaxLeavesPerYear").val() || 0),
            IsPaidLeave: $("#IsPaidLeave").is(':checked')
        };

        $.ajax({
            url: '@Url.Action("LeaveType", "Home")',
            type: 'POST',
            data: leaveTypeData,
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function (response) {
                if (response && response.success) {
                    alert(response.message);
                    $("#leaveTypeForm")[0].reset();
                    $("#LeaveTypeID").val(0);
                    $("#IsPaidLeave").prop('checked', false);
                    // refresh the list
                    LoadLeaveTypeList();
                    // reset button text to Submit after save
                    $("#btnSubmit").text('Submit');
                } else {
                    alert(response && response.message ? response.message : "Operation failed.");
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Something went wrong!");
            }
        });

    });

</script>

@model List<AdminPannel.Models.LeaveTypeResponse>

@if(Model == null || !Model.Any())
{
<div class="alert alert-info">No leave types found.</div>
}
else
{
<div class="table-responsive">
    <table class="table table-sm table-striped">
        <thead class="table-dark">
            <tr>
                <th style="width: 5%">#</th>
                <th style="width: 25%">Leave Type Name</th>
                <th style="width: 15%">Code</th>
                <th style="width: 15%">Max Days/Year</th>
                <th style="width: 15%">Type</th>
                <th style="width: 25%">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var item in Model)
            {
                <tr class="align-middle">
                    <td>@(Model.IndexOf(item) + 1)</td>
                    <td><strong>@item.LeaveTypeName</strong></td>
                    <td>@item.LeaveCode</td>
                    <td>@item.MaxLeavesPerYear</td>
                    <td>
                        @if(item.IsPaidLeave)
                        {
                            <span class="badge bg-success">Paid</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unpaid</span>
                        }
                    </td>
                    <td>
                        @if (User.IsInRole("Admin") || User.IsInRole("HR"))
                        {
                        <div class="btn-group btn-group-sm" role="group">
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="EditLeaveType(@item.LeaveTypeID)" title="Edit">
                                <i class="bi bi-pencil"></i> Edit
                            </button>
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="DeleteLeaveType(@item.LeaveTypeID)" title="Delete">
                                <i class="bi bi-trash"></i> Delete
                            </button>
                        </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
}

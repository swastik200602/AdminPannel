@{
    ViewData["Title"] = "Designation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<!--begin::App Content Header-->
<div class="app-content-header">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-sm-6">
                <h1 class="mb-0 fs-3">Designation</h1>
            </div>
            <div class="col-sm-6">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="#">Home</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Designation</li>
                    </ol>
                </nav>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>
<!--end::App Content Header-->
<div class="app-content">
    <div class="container-fluid">
        <div class="row g-4">

            <!-- Quick Example -->
            <div class="col-md-6">
                <div class="card card-primary card-outline mb-4">
                    <div class="card-header">
                        <div class="card-title">Add/Edit Designation</div>
                    </div>
                    <form id="designationForm">
                        @Html.AntiForgeryToken()
                        <div class="card-body">
                            <input type="hidden" id="DesignationID" name="DesignationID" value="0" />
                            <div class="mb-3">
                                <label for="DesignationName" class="form-label">Designation Name</label>
                                <input type="text"
                                       class="form-control"
                                       id="DesignationName"
                                       name="DesignationName" />

                            </div>
                            <div class="mb-3">
                                <label for="DesignationCode" class="form-label">Designation Code</label>
                                <input type="text" class="form-control" id="DesignationCode" name="DesignationCode" />
                            </div>
                            <div class="mb-3">
                                <label for="Description" class="form-label">Description</label>
                                <input type="text" class="form-control" id="Description" name="Description" />
                            </div>

                        </div>
                        <div class="card-footer">
                            <button type="button" id="btnSubmit" class="btn btn-primary">Submit</button>
                        </div>
                    </form>
                </div>
            </div>


            <!-- Checks & Radios -->
            <div class="col-md-6">
                <div class="card card-info card-outline mb-4">
                    <div class="card-header">
                        <h3 class="card-title">Designation List</h3>

                    </div>


                    <div class="card-body p-0" id="designationList">

                    </div>


                </div>
            </div>



        </div>
    </div>
</div>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>


<script>

     $(document).ready(function() {
      LoadDesignationList()
    });

    function LoadDesignationList() {
        $.ajax({
            url: '@Url.Action("GetDesignation", "Home")',
            type: 'GET',
            success: function (response) {
                $("#designationList").html(response);
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load designation list.");
            }
        });
    }

    function EditDesignation(id) {
        var model={
        DesignationID:id
        };

        $.ajax({
            url: '@Url.Action("GetDesignationById", "Home")',
            type: 'GET',
            data:model,
            success: function (response) {
              // populate all editable fields (response is camel-cased JSON from ASP.NET Core)
              $("#DesignationID").val(response.designationID || 0);
              $("#DesignationName").val(response.designationName || '');
              $("#DesignationCode").val(response.designationCode || '');
              $("#Description").val(response.description || '');
              // scroll to form (optional)
              window.scrollTo({ top: 0, behavior: 'smooth' });
              // change submit button to Update when editing
              $("#btnSubmit").text('Update');
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Failed to load designation.");
            }
        });
    }

    function DeleteDesignation(id) {
        if (!confirm('Delete designation?')) return;
        var token = $('input[name="__RequestVerificationToken"]').first().val();
        $.ajax({
            url: '@Url.Action("DeleteDesignation", "Home")',
            type: 'POST',
            data: { id: id },
            headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' },
            success: function (res) {
                if (res && res.success) {
                    alert(res.message);
                    LoadDesignationList();
                } else {
                    alert(res && res.message ? res.message : 'Delete failed');
                }
            },
            error: function (err) { console.log(err); alert('Server error'); }
        });
    }





    $("#btnSubmit").click(function (e) {
        e.preventDefault();

        var token = $('input[name="__RequestVerificationToken"]').val();

        var designationData = {
            DesignationID: parseInt($("#DesignationID").val() || 0),
            DesignationName: $("#DesignationName").val(),
            DesignationCode: $("#DesignationCode").val(),
            Description: $("#Description").val()
        };

        $.ajax({
            url: '@Url.Action("Designation", "Home")',
            type: 'POST',
            data: designationData,
            headers: {
                'RequestVerificationToken': token,
                'X-Requested-With': 'XMLHttpRequest'
            },
            success: function (response) {
                if (response && response.success) {
                    alert(response.message);
                    $("#designationForm")[0].reset();
                    $("#DesignationID").val(0);
                    // refresh the list
                    LoadDesignationList();
                    // reset button text to Submit after save
                    $("#btnSubmit").text('Submit');
                } else {
                    alert(response && response.message ? response.message : "Operation failed.");
                }
            },
            error: function (xhr, status, error) {
                console.log(xhr.responseText);
                alert("Something went wrong!");
            }
        });

    });
</script>


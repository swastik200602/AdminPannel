@model AdminPannel.Models.AttendanceModel
@{ var employees=ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Record attendance</h1><p class="text-body-secondary">Capture a present, leave, half-day or work-from-home record.</p></div></div><div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body"><form asp-action="AttendanceCreate" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Employee</label>@if(employees.Any()){<select asp-for="EmployeeID" class="form-select" required><option value="">Select employee</option>@foreach(var e in employees){<option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option>}</select>}else{<input asp-for="EmployeeID" type="hidden"/>}<span asp-validation-for="EmployeeID" class="text-danger"></span></div><div class="col-md-6"><label asp-for="AttendanceDate" class="form-label">Date</label><input asp-for="AttendanceDate" type="date" class="form-control" required/><span asp-validation-for="AttendanceDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Status" class="form-label">Status</label><select asp-for="Status" class="form-select"><option>Present</option><option>Absent</option><option>Leave</option><option>Half Day</option><option>Work From Home</option></select></div><div class="col-md-4"><label asp-for="CheckInTime" class="form-label">Check in</label><input asp-for="CheckInTime" type="time" class="form-control"/></div><div class="col-md-4"><label asp-for="CheckOutTime" class="form-label">Check out</label><input asp-for="CheckOutTime" type="time" class="form-control"/></div><div class="col-md-6"><label asp-for="WorkingHours" class="form-label">Working hours</label><input asp-for="WorkingHours" type="number" step="0.01" min="0" class="form-control"/></div><div class="col-md-6"><label asp-for="OvertimeHours" class="form-label">Overtime hours</label><input asp-for="OvertimeHours" type="number" step="0.01" min="0" class="form-control"/></div><div class="col-12"><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control" rows="3"></textarea></div></div><div class="mt-4"><button class="btn btn-primary">Save attendance</button> <a asp-action="Attendance" class="btn btn-outline-secondary">Cancel</a></div></form></div></div></div></div>

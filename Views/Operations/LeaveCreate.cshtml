@model AdminPannel.Models.LeaveRequestModel
@{ ViewData["Title"] = "Request Leave"; var types = ViewBag.LeaveTypes as List<AdminPannel.Models.LeaveTypeResponse> ?? new(); }
<div class="container-fluid py-4"><div class="mb-4"><span class="text-primary fw-semibold">PEOPLE OPERATIONS</span><h1>Request leave</h1><p class="text-secondary">Submit a request for manager approval.</p></div><div class="card"><div class="card-body"><form asp-action="LeaveCreate" method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-4"><label asp-for="LeaveTypeID" class="form-label">Leave type</label><select asp-for="LeaveTypeID" class="form-select"><option value="">Select leave type</option>@foreach(var t in types){<option value="@t.LeaveTypeID">@t.LeaveTypeName</option>}</select><span asp-validation-for="LeaveTypeID" class="text-danger"></span></div><div class="col-md-4"><label asp-for="FromDate" class="form-label">From</label><input asp-for="FromDate" type="date" class="form-control"/><span asp-validation-for="FromDate" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ToDate" class="form-label">To</label><input asp-for="ToDate" type="date" class="form-control"/><span asp-validation-for="ToDate" class="text-danger"></span></div><div class="col-12"><label asp-for="Reason" class="form-label">Reason</label><textarea asp-for="Reason" class="form-control" rows="4"></textarea><span asp-validation-for="Reason" class="text-danger"></span></div></div><div class="mt-4"><button class="btn btn-primary">Submit request</button><a asp-action="Leave" class="btn btn-outline-secondary ms-2">Cancel</a></div></form></div></div></div>

@model List<AdminPannel.Models.AnnouncementModel>
@{ ViewData["Title"] = "Announcements"; var canManage=User.IsInRole("Admin")||User.IsInRole("HR"); }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary fw-semibold">COMMUNICATIONS</span><h1>Announcements</h1><p class="text-secondary mb-0">Share important updates with the entire workforce.</p></div>@if(canManage){<a asp-action="AnnouncementCreate" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New announcement</a>}</div><div class="row g-3">@if(!Model.Any()){<div class="col-12"><div class="card"><div class="card-body text-center text-secondary py-5">No announcements available.</div></div></div>}else{foreach(var row in Model){<div class="col-lg-6"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between"><h3 class="h5">@row.Title</h3><span class="badge text-bg-@(row.IsActive?"success":"secondary")">@(row.IsActive?"Published":"Inactive")</span></div><p class="text-secondary">@row.Description</p><small class="text-secondary">Published @row.PublishDate.ToString("dd-MMM-yyyy")@(row.ExpiryDate.HasValue ? $" · Expires {row.ExpiryDate:dd-MMM-yyyy}" : "")</small>@if(canManage){<div class="mt-3"><form asp-action="AnnouncementToggle" method="post"><input type="hidden" name="id" value="@row.AnnouncementID"/><button class="btn btn-sm btn-outline-@(row.IsActive?"danger":"success")">@(row.IsActive?"Deactivate":"Publish")</button></form></div>}</div></article></div>}}</div></div>

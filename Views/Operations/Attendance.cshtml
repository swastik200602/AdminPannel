@model IEnumerable<AdminPannel.Models.AttendanceModel>
@{ var employees=ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="app-content-header"><div class="container-fluid"><div class="d-flex justify-content-between align-items-end"><div><div class="text-primary small text-uppercase fw-semibold">People operations</div><h1 class="fs-3 mb-1">Attendance</h1><p class="text-body-secondary mb-0">Monitor attendance, working hours and approved work-from-home records.</p></div><a asp-action="AttendanceCreate" class="btn btn-primary"><i class="bi bi-calendar-plus me-1"></i>Record attendance</a></div></div></div>
<div class="app-content"><div class="container-fluid">@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}<div class="card mb-3"><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-lg-3"><label class="form-label">Employee</label><select name="employeeId" class="form-select"><option value="">All employees</option>@foreach(var e in employees){<option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option>}</select></div><div class="col-md-3"><label class="form-label">From</label><input name="fromDate" type="date" class="form-control"/></div><div class="col-md-3"><label class="form-label">To</label><input name="toDate" type="date" class="form-control"/></div><div class="col-md-2"><label class="form-label">Status</label><select name="status" class="form-select"><option value="">All</option><option>Present</option><option>Absent</option><option>Leave</option><option>Half Day</option><option>Work From Home</option></select></div><div class="col-md-1"><button class="btn btn-primary w-100">Go</button></div></form></div></div><div class="card"><div class="card-header"><h2 class="h5 mb-0">Attendance register</h2></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee</th><th>Date</th><th>Shift</th><th>Check in</th><th>Check out</th><th>Hours</th><th>Status</th><th>Remarks</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="8" class="text-center p-5 text-body-secondary">No attendance records found.</td></tr>}else{foreach(var a in Model){<tr><td><strong>@a.FullName</strong><div class="small text-body-secondary">@a.EmployeeCode</div></td><td>@a.AttendanceDate.ToString("dd-MMM-yyyy")</td><td>@(a.ShiftName ?? "-")</td><td>@(a.CheckInTime?.ToString(@"hh\:mm") ?? "-")</td><td>@(a.CheckOutTime?.ToString(@"hh\:mm") ?? "-")</td><td>@(a.WorkingHours?.ToString("0.##") ?? "-")</td><td><span class="badge rounded-pill text-bg-info">@a.Status</span></td><td>@a.Remarks</td></tr>}}</tbody></table></div></div></div></div></div>

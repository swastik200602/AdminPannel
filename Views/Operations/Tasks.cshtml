@model List<AdminPannel.Models.TaskModel>
@{ ViewData["Title"] = "Tasks"; var canCreate=User.IsInRole("Admin")||User.IsInRole("HR")||User.IsInRole("Manager"); }
<div class="container-fluid py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><span class="text-primary fw-semibold">PEOPLE OPERATIONS</span><h1>Team tasks</h1><p class="text-secondary mb-0">Assign work, track progress and keep ownership clear.</p></div>@if(canCreate){<a class="btn btn-primary" asp-action="TaskCreate"><i class="bi bi-plus-lg me-1"></i>Assign task</a>}</div><div class="card"><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Task</th><th>Employee</th><th>Priority</th><th>Due</th><th>Status</th><th>Assigned by</th><th>Action</th></tr></thead><tbody>@if(!Model.Any()){<tr><td colspan="7" class="text-center text-secondary py-5">No tasks found.</td></tr>}else{foreach(var row in Model){var cls=row.Status switch{"Completed"=>"success","Cancelled"=>"danger","In Progress"=>"info",_=>"warning"};<tr><td><strong>@row.TaskTitle</strong><small class="d-block text-secondary">@row.TaskDescription</small></td><td><strong>@row.EmployeeName</strong><small class="d-block text-secondary">@row.EmployeeCode</small></td><td><span class="badge text-bg-secondary">@row.Priority</span></td><td>@row.DueDate.ToString("dd-MMM-yyyy")</td><td><span class="badge text-bg-@cls">@row.Status</span></td><td>@row.AssignedByName</td><td><form asp-action="TaskStatus" method="post" class="d-flex gap-1"><input type="hidden" name="id" value="@row.TaskID"/><select name="status" class="form-select form-select-sm"><option>Pending</option><option>In Progress</option><option>Completed</option><option>Cancelled</option></select><button class="btn btn-sm btn-outline-primary">Update</button></form></td></tr>}}</tbody></table></div></div></div>

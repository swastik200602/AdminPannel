@model AdminPannel.Models.ChangePasswordRequest
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewData["Title"] = "Change Password"; }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Change Password</h1></div></div>
<div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body" style="max-width:600px">
<form asp-action="ChangePassword" method="post">@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="CurrentPassword" class="form-label">Current password</label><input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" /></div>
<div class="mb-3"><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" type="password" class="form-control" autocomplete="new-password" /></div>
<div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" type="password" class="form-control" autocomplete="new-password" /></div>
<button class="btn btn-primary" type="submit">Change password</button>
</form></div></div></div></div>

@model AdminPannel.Models.EmployeeContextModel
<div class="employee-context-card d-flex align-items-center gap-3 mb-3 p-3 rounded border border-secondary-subtle bg-body-tertiary">
    @if (!string.IsNullOrWhiteSpace(Model.ProfileImage))
    { <img src="@Model.ProfileImage" alt="@Model.FullName" class="rounded-circle shadow-sm" style="width:72px;height:72px;object-fit:cover;" /> }
    else
    { <div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold fs-3" style="width:72px;height:72px;">@(string.IsNullOrWhiteSpace(Model.FullName) ? "?" : Model.FullName.Substring(0,1).ToUpperInvariant())</div> }
    <div>
        <div class="fs-4 fw-semibold">@(Model.FullName ?? "Employee")</div>
        <div class="small text-body-secondary fw-semibold">@(Model.EmployeeCode ?? $"Employee #{Model.EmployeeID}")</div>
        <div class="small">@(Model.DesignationName ?? "Not assigned") <span class="text-body-secondary mx-1">•</span> @(Model.DepartmentName ?? "Not assigned")</div>
        <div class="small text-body-secondary">@(Model.OfficeName ?? "Not assigned") <span class="mx-1">•</span> Joined: @(Model.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")
            @if (Model.IsActive.HasValue) { <span class="badge ms-2 @(Model.IsActive.Value ? "bg-success" : "bg-secondary")">@(Model.IsActive.Value ? "Active" : "Inactive")</span> }
        </div>
    </div>
</div>

                            <li class="nav-item"><a asp-controller="Payroll" asp-action="Bonus" class="nav-link @(IsAction("Bonus", "CreateBonus", "EditBonus", "CancelBonus") ? "active" : "")"><i class="nav-icon bi bi-circle"></i><p>Bonuses</p></a></li>
                            <li class="nav-item"><a asp-controller="Payroll" asp-action="Advance" class="nav-link @(IsAction("Advance", "CreateAdvance", "EditAdvance", "CancelAdvance") ? "active" : "")"><i class="nav-icon bi bi-circle"></i><p>Advances / Loans</p></a></li>

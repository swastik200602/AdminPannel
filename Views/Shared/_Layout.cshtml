                        }
                        @if (User.IsInRole("Employee"))
                        {
                            <li class="nav-item"><a asp-controller="Payroll" asp-action="History" class="nav-link"><i class="nav-icon bi bi-circle"></i><p>My Payroll</p></a></li>

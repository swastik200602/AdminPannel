@model AdminPannel.Models.SalaryAdvanceRequestModel
@{ var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="mb-3"><label asp-for="EmployeeID" class="form-label">Employee</label><select asp-for="EmployeeID" class="form-select"><option value="0">Select employee</option>@foreach (var e in employees) { <option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option> }</select></div><div class="row g-3"><div class="col-md-4"><label asp-for="TransactionType" class="form-label">Type</label><select asp-for="TransactionType" class="form-select"><option>Advance</option><option>Loan</option></select></div><div class="col-md-4"><label asp-for="TotalAmount" class="form-label">Total amount</label><input asp-for="TotalAmount" class="form-control" min="0.01" step="0.01" /></div><div class="col-md-4"><label asp-for="MonthlyRecoveryAmount" class="form-label">Monthly recovery</label><input asp-for="MonthlyRecoveryAmount" class="form-control" min="0.01" step="0.01" /></div><div class="col-md-4"><label asp-for="IssueDate" class="form-label">Issue date</label><input asp-for="IssueDate" type="date" class="form-control" /></div><div class="col-md-4"><label asp-for="RecoveryStartMonth" class="form-label">Recovery month</label><input asp-for="RecoveryStartMonth" class="form-control" min="1" max="12" /></div><div class="col-md-4"><label asp-for="RecoveryStartYear" class="form-label">Recovery year</label><input asp-for="RecoveryStartYear" class="form-control" min="2000" /></div></div><div class="mb-3 mt-3"><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control" maxlength="500"></textarea></div>

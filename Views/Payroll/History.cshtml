@model IEnumerable<AdminPannel.Models.PayrollModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var filter = ViewBag.Filter as AdminPannel.Models.PayrollHistoryFilterModel ?? new(); var context = ViewBag.EmployeeContext as AdminPannel.Models.EmployeeContextModel; var isEmployee = User.IsInRole("Employee"); var isManager = User.IsInRole("Manager"); }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3 mb-1">@(isEmployee ? "My Payroll History" : isManager ? "Team Payroll History" : "Payroll History")</h1><p class="text-body-secondary mb-0">@(isEmployee ? "Your historical salary and payment records." : isManager ? "Read-only payroll history for your team." : "View historical salary and payment records.")</p></div></div>
<div class="app-content"><div class="container-fluid">
@if (context != null) { @await Html.PartialAsync("_EmployeeContextCard", context) }
@if (!isEmployee) { <div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-3"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID" selected="@(filter.EmployeeID == e.EmployeeID)">@e.FullName — @e.EmployeeCode</option> }</select></div><div class="col-lg-2"><label class="form-label">From month</label><input name="FromMonth" value="@filter.FromMonth" type="number" min="1" max="12" class="form-control" /></div><div class="col-lg-2"><label class="form-label">From year</label><input name="FromYear" value="@filter.FromYear" type="number" min="2000" class="form-control" /></div><div class="col-lg-2"><label class="form-label">To month</label><input name="ToMonth" value="@filter.ToMonth" type="number" min="1" max="12" class="form-control" /></div><div class="col-lg-2"><label class="form-label">To year</label><input name="ToYear" value="@filter.ToYear" type="number" min="2000" class="form-control" /></div><div class="col-lg-1"><button class="btn btn-primary">Filter</button></div><div class="col-lg-2"><select name="PaymentStatus" class="form-select"><option value="">All status</option><option selected="@(filter.PaymentStatus == "Paid")">Paid</option><option selected="@(filter.PaymentStatus == "Pending")">Pending</option><option selected="@(filter.PaymentStatus == "Processing")">Processing</option><option selected="@(filter.PaymentStatus == "Failed")">Failed</option></select></div></form></div></div> }
@if (!Model.Any()) { <div class="alert alert-info">No historical payroll records found.</div> } else { <div class="card"><div class="card-header"><h2 class="h5 mb-0">Historical payroll report</h2></div><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Period</th><th class="text-end">Gross earnings</th><th class="text-end">Bonus</th><th class="text-end">Tax</th><th class="text-end">Advance recovery</th><th class="text-end">Net salary</th><th>Status</th><th>Salary slip</th></tr></thead><tbody>@foreach (var p in Model) { var e = employees.FirstOrDefault(x => x.EmployeeID == p.EmployeeID); var badge = p.PaymentStatus == "Paid" ? "bg-success" : p.PaymentStatus == "Failed" ? "bg-danger" : "bg-warning text-dark"; <tr><td><div class="fw-semibold">@(p.EmployeeName ?? e?.FullName ?? "Employee")</div><small class="text-body-secondary">@(p.EmployeeCode ?? e?.EmployeeCode ?? $"#{p.EmployeeID}")</small><div class="small text-body-secondary">@(e?.DesignationName ?? "-") • @(e?.DepartmentName ?? "-")</div></td><td>@(new DateTime(p.PayrollYear, p.PayrollMonth, 1).ToString("MMM yyyy"))</td><td class="text-end">₹@((p.BasicSalary + p.Allowance).ToString("N0"))</td><td class="text-end">₹@p.Bonus.ToString("N0")</td><td class="text-end">₹@p.Tax.ToString("N0")</td><td class="text-end">₹@p.AdvanceRecovery.ToString("N0")</td><td class="text-end fw-semibold">₹@p.NetSalary.ToString("N0")</td><td><span class="badge @badge">@(p.PaymentStatus ?? "Unknown")</span></td><td><a asp-action="SalarySlip" asp-route-id="@p.PayrollID" class="btn btn-sm btn-outline-info">View slip</a></td></tr> }</tbody></table></div></div> }
</div></div>

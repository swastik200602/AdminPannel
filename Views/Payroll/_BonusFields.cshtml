@model AdminPannel.Models.BonusRequestModel
@{ var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="mb-3"><label asp-for="EmployeeID" class="form-label">Employee</label><select asp-for="EmployeeID" class="form-select"><option value="0">Select employee</option>@foreach (var e in employees) { <option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option> }</select></div><div class="row g-3"><div class="col-md-4"><label asp-for="BonusAmount" class="form-label">Amount</label><input asp-for="BonusAmount" class="form-control" min="0.01" step="0.01" /></div><div class="col-md-4"><label asp-for="BonusMonth" class="form-label">Month</label><input asp-for="BonusMonth" class="form-control" min="1" max="12" /></div><div class="col-md-4"><label asp-for="BonusYear" class="form-label">Year</label><input asp-for="BonusYear" class="form-control" min="2000" /></div></div><div class="mb-3 mt-3"><label asp-for="BonusType" class="form-label">Bonus type</label><input asp-for="BonusType" class="form-control" maxlength="50" /></div><div class="mb-3"><label asp-for="Reason" class="form-label">Reason</label><textarea asp-for="Reason" class="form-control" maxlength="250"></textarea></div>

@model IEnumerable<AdminPannel.Models.TaxMasterModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var filter = ViewBag.Filter as AdminPannel.Models.TaxMasterFilterModel ?? new(); var selected = filter.EmployeeID.HasValue ? employees.FirstOrDefault(e => e.EmployeeID == filter.EmployeeID.Value) : null; }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start"><div><h1 class="fs-3 mb-1">Tax / TDS Master</h1><p class="text-body-secondary mb-0">Manage employee-specific tax and TDS configurations.</p></div><a asp-action="CreateTaxRevision" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New revision</a></div></div><div class="app-content"><div class="container-fluid">
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> } @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success">@TempData["PayrollMessage"]</div> }
@if (selected != null) { @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = selected.EmployeeID, FullName = selected.FullName, EmployeeCode = selected.EmployeeCode, ProfileImage = selected.ProfileImage, DesignationName = selected.DesignationName, DepartmentName = selected.DepartmentName, OfficeName = selected.OfficeName, JoiningDate = selected.JoiningDate, IsActive = selected.IsActive }) }
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-5"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID" selected="@(filter.EmployeeID == e.EmployeeID)">@e.FullName — @e.EmployeeCode</option> }</select></div><div class="col-lg-3"><label class="form-label">Tax type</label><select name="TaxType" class="form-select"><option value="">All types</option><option value="TDS" selected="@(filter.TaxType == "TDS")">TDS</option><option value="IncomeTax" selected="@(filter.TaxType == "IncomeTax")">Income Tax</option><option value="Other" selected="@(filter.TaxType == "Other")">Other</option></select></div><div class="col-lg-2"><label class="form-label">Status</label><select name="IsActive" class="form-select"><option value="true" selected="@(filter.IsActive == true)">Active</option><option value="false" selected="@(filter.IsActive == false)">Inactive</option><option value="" selected="@(filter.IsActive == null)">All</option></select></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary">Filter</button><a asp-action="TaxMaster" class="btn btn-outline-secondary">Clear</a></div></form></div></div>
@if (!Model.Any()) { <div class="alert alert-info">No tax configuration found.</div> } else { <div class="card"><div class="card-header"><h2 class="h5 mb-0">Employee tax configuration</h2></div><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Context</th><th>Tax type</th><th class="text-end">Tax amount</th><th>Validity</th><th>Status</th><th>Reason</th><th>Actions</th></tr></thead><tbody>@foreach (var t in Model) { var e = employees.FirstOrDefault(x => x.EmployeeID == t.EmployeeID); var typeClass = t.TaxType == "TDS" ? "bg-primary" : t.TaxType == "IncomeTax" ? "bg-info text-dark" : "bg-secondary"; <tr><td><div class="fw-semibold">@(t.EmployeeName ?? e?.FullName ?? "Employee")</div><small class="text-body-secondary">@(t.EmployeeCode ?? e?.EmployeeCode ?? $"#{t.EmployeeID}")</small></td><td><div>@(e?.DesignationName ?? "-")</div><small class="text-body-secondary">@(e?.DepartmentName ?? "-")</small></td><td><span class="badge @typeClass">@(t.TaxType == "IncomeTax" ? "Income Tax" : t.TaxType)</span></td><td class="text-end fw-semibold">₹@t.TaxAmount.ToString("N0")</td><td><div>@t.EffectiveFrom.ToString("dd-MMM-yyyy")</div><small class="text-body-secondary">@(t.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Present")</small></td><td><span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">@(t.IsActive ? "Active" : "Historical")</span></td><td>@(t.Reason ?? "-")</td><td><a asp-action="TaxHistory" asp-route-employeeId="@t.EmployeeID" class="btn btn-sm btn-outline-info">History</a></td></tr> }</tbody></table></div></div> }
</div></div>

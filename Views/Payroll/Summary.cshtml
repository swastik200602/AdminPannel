@model AdminPannel.Models.PayrollSummaryModel
@using System.Globalization
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var month = (byte?)(ViewBag.Month ?? DateTime.Today.Month); var year = (short?)(ViewBag.Year ?? DateTime.Today.Year); var total = Math.Max(Model.TotalPayrollRecords, 1); }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-center flex-wrap gap-2"><div><h1 class="fs-3 mb-1">Payroll Dashboard</h1><div class="text-body-secondary">Company payroll overview for @CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month ?? 1) @year</div></div><form method="get" class="d-flex gap-2"><select name="month" class="form-select"><option value="1" selected="@(month == 1)">January</option><option value="2" selected="@(month == 2)">February</option><option value="3" selected="@(month == 3)">March</option><option value="4" selected="@(month == 4)">April</option><option value="5" selected="@(month == 5)">May</option><option value="6" selected="@(month == 6)">June</option><option value="7" selected="@(month == 7)">July</option><option value="8" selected="@(month == 8)">August</option><option value="9" selected="@(month == 9)">September</option><option value="10" selected="@(month == 10)">October</option><option value="11" selected="@(month == 11)">November</option><option value="12" selected="@(month == 12)">December</option></select><input name="year" value="@year" type="number" class="form-control" min="2000" style="width:110px" /><button class="btn btn-primary">View</button></form></div></div>
<div class="app-content"><div class="container-fluid"><h2 class="h5 mb-3">Payroll status</h2><div class="row g-3 mb-4">@foreach (var item in new[] { ("Total payroll", Model.TotalPayrollRecords, "primary"), ("Paid", Model.PaidCount, "success"), ("Pending", Model.PendingCount, "warning"), ("Processing", Model.ProcessingCount, "info"), ("Failed", Model.FailedCount, "danger") }) { <div class="col-sm-6 col-xl"><div class="card border-start border-4 border-@item.Item3 h-100"><div class="card-body"><div class="small text-body-secondary">@item.Item1</div><div class="fs-3 fw-semibold">@item.Item2</div></div></div></div> }</div><h2 class="h5 mb-3">Financial overview</h2><div class="row g-3 mb-4">@foreach (var item in new[] { ("Gross payroll", Model.TotalBasicSalary + Model.TotalAllowance + Model.TotalBonus), ("Total bonus", Model.TotalBonus), ("Total tax", Model.TotalTax), ("Total deductions", Model.TotalDeduction), ("Advance recovery", Model.TotalAdvanceRecovery), ("Net payroll", Model.TotalNetSalary) }) { <div class="col-sm-6 col-xl-2"><div class="card h-100"><div class="card-body"><div class="small text-body-secondary">@item.Item1</div><div class="fs-5 fw-semibold">₹@item.Item2.ToString("N0")</div></div></div></div> }</div><div class="row g-3"><div class="col-lg-7"><div class="card h-100"><div class="card-header"><h2 class="h5 mb-0">Payroll health</h2></div><div class="card-body">@foreach (var item in new[] { ("Paid", Model.PaidCount, "success"), ("Pending", Model.PendingCount, "warning"), ("Processing", Model.ProcessingCount, "info"), ("Failed", Model.FailedCount, "danger") }) { <div class="d-flex align-items-center gap-2 mb-3"><span style="width:85px">@item.Item1</span><div class="progress flex-grow-1" style="height:10px"><div class="progress-bar bg-@item.Item3" style="width:@(item.Item2 * 100 / total)%"></div></div><span class="small">@item.Item2</span></div> }</div></div></div><div class="col-lg-5"><div class="card h-100"><div class="card-header"><h2 class="h5 mb-0">Quick actions</h2></div><div class="card-body d-grid gap-2"><a asp-action="Generate" class="btn btn-primary">Generate payroll</a><a asp-action="Index" class="btn btn-outline-secondary">View payroll records</a><a asp-action="SalaryMaster" class="btn btn-outline-secondary">Salary Master</a></div></div></div></div></div></div>

@model IEnumerable<AdminPannel.Models.PayrollModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Payroll Records</h1></div></div>
<div class="app-content"><div class="container-fluid">
 @if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> }
 @if (TempData["PayrollError"] != null) { <div class="alert alert-danger">@TempData["PayrollError"]</div> }
 @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success">@TempData["PayrollMessage"]</div> }
 <div class="card mb-3"><div class="card-body"><form method="get" class="row g-2"><div class="col-md-3"><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option> }</select></div><div class="col-md-2"><input name="PayrollMonth" class="form-control" type="number" min="1" max="12" placeholder="Month" /></div><div class="col-md-2"><input name="PayrollYear" class="form-control" type="number" min="2000" placeholder="Year" /></div><div class="col-md-2"><select name="PaymentStatus" class="form-select"><option value="">All statuses</option><option>Pending</option><option>Processing</option><option>Paid</option><option>Failed</option></select></div><div class="col-md-3"><button class="btn btn-primary">Filter</button> <a class="btn btn-outline-secondary" asp-action="Index">Clear</a> <a class="btn btn-success" asp-action="Generate">Generate</a></div></form></div></div>
 <div class="card"><div class="card-body table-responsive"><table class="table table-striped"><thead><tr><th>Employee Name</th><th>Employee Code</th><th>Department</th><th>Designation</th><th>Period</th><th>Basic</th><th>Bonus</th><th>Tax</th><th>Advance</th><th>Net</th><th>Status</th><th></th></tr></thead><tbody>
 @foreach (var p in Model) { var employee = employees.FirstOrDefault(e => e.EmployeeID == p.EmployeeID); <tr><td class="fw-semibold">@(p.EmployeeName ?? employee?.FullName ?? "Employee")</td><td>@(p.EmployeeCode ?? employee?.EmployeeCode ?? $"#{p.EmployeeID}")</td><td>@(employee?.DepartmentName ?? "-")</td><td>@(employee?.DesignationName ?? "-")</td><td>@p.PayrollMonth/@p.PayrollYear</td><td>@p.BasicSalary.ToString("N2")</td><td>@p.Bonus.ToString("N2")</td><td>@p.Tax.ToString("N2")</td><td>@p.AdvanceRecovery.ToString("N2")</td><td>@p.NetSalary.ToString("N2")</td><td>@p.PaymentStatus</td><td><a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@p.PayrollID">View</a>@if (User.IsInRole("Admin") || User.IsInRole("HR")) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.PayrollID">Edit</a> <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this payroll record?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.PayrollID" /><button class="btn btn-sm btn-outline-danger">Delete</button></form> }</td></tr> }
 </tbody></table></div></div>
</div></div>

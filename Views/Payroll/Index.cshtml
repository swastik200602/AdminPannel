@model IEnumerable<AdminPannel.Models.PayrollModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var rows = Model?.ToList() ?? new List<AdminPannel.Models.PayrollModel>();
    var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>();
    var paid = rows.Count(x => string.Equals(x.PaymentStatus, "Paid", StringComparison.OrdinalIgnoreCase));
    var pending = rows.Count(x => string.Equals(x.PaymentStatus, "Pending", StringComparison.OrdinalIgnoreCase));
    var processing = rows.Count(x => string.Equals(x.PaymentStatus, "Processing", StringComparison.OrdinalIgnoreCase));
    var statusClass = (string? status) => status?.ToLowerInvariant() switch
    {
        "paid" => "text-bg-success", "pending" => "text-bg-warning", "processing" => "text-bg-info", "failed" => "text-bg-danger", _ => "text-bg-secondary"
    };
    var currency = (decimal value) => $"₹{value:N0}";
}
<div class="app-content-header"><div class="container-fluid"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><div class="text-primary text-uppercase small fw-semibold">Payroll workspace</div><h1 class="mb-1 fs-3">Payroll Records</h1><p class="text-body-secondary mb-0">Review employee payroll, payment status and monthly earnings in one place.</p></div>@if (User.IsInRole("Admin") || User.IsInRole("HR")){<a asp-action="Generate" class="btn btn-primary btn-lg"><i class="bi bi-lightning-charge me-1"></i>Generate new payroll</a>}</div></div></div>
<div class="app-content"><div class="container-fluid">
@if (ViewBag.Error != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error</div> } @if (TempData["PayrollError"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["PayrollError"]</div> } @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["PayrollMessage"]</div> }
<div class="row g-3 mb-4"><div class="col-sm-6 col-xl-3"><div class="card h-100 border-start border-4 border-primary"><div class="card-body"><div class="small text-body-secondary text-uppercase">Payroll records</div><div class="fs-3 fw-semibold">@rows.Count</div><div class="small text-body-secondary">Current view</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card h-100 border-start border-4 border-success"><div class="card-body"><div class="small text-body-secondary text-uppercase">Paid</div><div class="fs-3 fw-semibold">@paid</div><div class="small text-body-secondary">Completed payments</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card h-100 border-start border-4 border-warning"><div class="card-body"><div class="small text-body-secondary text-uppercase">Pending</div><div class="fs-3 fw-semibold">@pending</div><div class="small text-body-secondary">Awaiting completion</div></div></div></div><div class="col-sm-6 col-xl-3"><div class="card h-100 border-start border-4 border-info"><div class="card-body"><div class="small text-body-secondary text-uppercase">Processing</div><div class="fs-3 fw-semibold">@processing</div><div class="small text-body-secondary">Currently being processed</div></div></div></div></div>
<div class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">Find payroll records</h2><p class="small text-body-secondary mb-0">Filter by employee, period or payment status.</p></div><i class="bi bi-funnel text-primary fs-4"></i></div><div class="card-body"><form method="get" class="row g-3 align-items-end"><div class="col-lg-4"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option> }</select></div><div class="col-sm-6 col-lg-2"><label class="form-label">Month</label><input name="PayrollMonth" class="form-control" type="number" min="1" max="12" placeholder="e.g. 8" /></div><div class="col-sm-6 col-lg-2"><label class="form-label">Year</label><input name="PayrollYear" class="form-control" type="number" min="2000" placeholder="e.g. 2026" /></div><div class="col-lg-2"><label class="form-label">Payment status</label><select name="PaymentStatus" class="form-select"><option value="">All statuses</option><option>Pending</option><option>Processing</option><option>Paid</option><option>Failed</option></select></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary flex-grow-1" type="submit"><i class="bi bi-search me-1"></i>Filter</button><a class="btn btn-outline-secondary" asp-action="Index">Clear</a></div></form></div></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">Employee payroll</h2><p class="small text-body-secondary mb-0">Detailed earnings, deductions and payable amount.</p></div><span class="badge text-bg-secondary">@rows.Count records</span></div><div class="card-body p-0"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee</th><th>Work context</th><th>Period</th><th class="text-end">Basic</th><th class="text-end">Bonus</th><th class="text-end">Tax</th><th class="text-end">Advance</th><th class="text-end">Net salary</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>
@if (!rows.Any()) { <tr><td colspan="10"><div class="text-center p-5"><i class="bi bi-wallet2 fs-1 text-body-secondary"></i><h3 class="h5 mt-3">No payroll records found</h3><p class="text-body-secondary mb-0">Try adjusting the filters or generate payroll for an onboarded employee.</p></div></td></tr> } else { foreach (var p in rows) { var employee = employees.FirstOrDefault(e => e.EmployeeID == p.EmployeeID); <tr><td><div class="fw-semibold">@(p.EmployeeName ?? employee?.FullName ?? "Employee")</div><div class="small text-body-secondary">@(p.EmployeeCode ?? employee?.EmployeeCode ?? $"#{p.EmployeeID}")</div></td><td><div>@(employee?.DepartmentName ?? "Department unavailable")</div><div class="small text-body-secondary">@(employee?.DesignationName ?? "Designation unavailable")</div></td><td class="text-nowrap">@System.Globalization.CultureInfo.InvariantCulture.DateTimeFormat.GetAbbreviatedMonthName(p.PayrollMonth) @p.PayrollYear</td><td class="text-end text-nowrap">@currency(p.BasicSalary)</td><td class="text-end text-nowrap">@currency(p.Bonus)</td><td class="text-end text-nowrap">@currency(p.Tax)</td><td class="text-end text-nowrap">@currency(p.AdvanceRecovery)</td><td class="text-end text-nowrap fw-semibold">@currency(p.NetSalary)</td><td><span class="badge rounded-pill @statusClass(p.PaymentStatus)">@p.PaymentStatus</span></td><td class="text-end text-nowrap"><a class="btn btn-sm btn-outline-info" asp-action="Details" asp-route-id="@p.PayrollID"><i class="bi bi-eye me-1"></i>View</a>@if (User.IsInRole("Admin") || User.IsInRole("HR")) { <a class="btn btn-sm btn-outline-primary ms-1" asp-action="Edit" asp-route-id="@p.PayrollID"><i class="bi bi-pencil"></i></a> <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Delete this payroll record?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.PayrollID" /><button class="btn btn-sm btn-outline-danger ms-1" title="Delete"><i class="bi bi-trash"></i></button></form> }</td></tr> } }
</tbody></table></div></div></div>
</div></div>

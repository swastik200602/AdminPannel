@model AdminPannel.Models.TaxRevisionModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Tax Revision</h1></div></div><div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body"><div asp-validation-summary="All" class="text-danger"></div><form asp-action="CreateTaxRevision" method="post">@Html.AntiForgeryToken()<div class="mb-3"><label asp-for="EmployeeID" class="form-label">Employee</label><select asp-for="EmployeeID" class="form-select"><option value="0">Select employee</option>@foreach (var e in employees) { <option value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option> }</select></div><div class="row g-3"><div class="col-md-4"><label asp-for="TaxType" class="form-label">Tax type</label><select asp-for="TaxType" class="form-select"><option>TDS</option><option>IncomeTax</option><option>Other</option></select></div><div class="col-md-4"><label asp-for="TaxAmount" class="form-label">Tax amount</label><input asp-for="TaxAmount" class="form-control" min="0" step="0.01" /></div><div class="col-md-4"><label asp-for="EffectiveFrom" class="form-label">Effective from</label><input asp-for="EffectiveFrom" type="date" class="form-control" /></div></div><div class="mb-3 mt-3"><label asp-for="Reason" class="form-label">Reason</label><textarea asp-for="Reason" class="form-control" maxlength="250"></textarea></div><button class="btn btn-primary" type="submit">Save revision</button> <a class="btn btn-outline-secondary" asp-action="TaxMaster">Cancel</a></form></div></div></div></div>

@model AdminPannel.Models.SalaryRevisionModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as
    IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>();
}
<div class="app-content-header">
    <div class="container-fluid">
        <h1 class="fs-3">Salary Revision</h1>
    </div>
</div>
<div class="app-content">
    <div class="container-fluid">
        @if (ViewBag.EmployeeContext is AdminPannel.Models.EmployeeContextModel context)
        {
            <div class="alert alert-info d-flex justify-content-between align-items-center"><span><i class="bi bi-person-check me-2"></i>Setting salary for <strong>@context.FullName</strong> <span class="text-body-secondary">(@context.EmployeeCode)</span></span><a asp-controller="Employee" asp-action="Onboarding" asp-route-employeeId="@context.EmployeeID" class="btn btn-sm btn-outline-primary">Back to onboarding</a></div>
        }
        <div class="card">
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger"></div>
                <form asp-action="CreateSalaryRevision" method="post">@Html.AntiForgeryToken()<div class="mb-3"><label
                    asp-for="EmployeeID" class="form-label">Employee</label><select asp-for="EmployeeID"
                                                                                class="form-select">
                    <option value="0">Select employee</option>@foreach (var e in employees) {
                    <option
                    value="@e.EmployeeID">@e.FullName (@e.EmployeeCode)</option>
                }
            </select></div>
            <div class="row g-3">
                <div class="col-md-4"><label asp-for="BasicSalary" class="form-label">Basic salary</label><input
                    asp-for="BasicSalary" class="form-control" min="0" step="0.01" /></div>
                    <div class="col-md-4"><label asp-for="Allowance" class="form-label">Allowance</label><input
                        asp-for="Allowance" class="form-control" min="0" step="0.01" /></div>
                        <div class="col-md-4"><label asp-for="Bonus" class="form-label">Bonus</label><input
                            asp-for="Bonus" class="form-control" min="0" step="0.01" /></div>
                            <div class="col-md-4"><label asp-for="Deduction" class="form-label">Deduction</label><input
                                asp-for="Deduction" class="form-control" min="0" step="0.01" /></div>
                                <div class="col-md-4"><label asp-for="Tax" class="form-label">Tax</label><input asp-for="Tax"
                                                                                                                    class="form-control" min="0" step="0.01" /></div>
                                    <div class="col-md-4"><label asp-for="EffectiveFrom" class="form-label">Effective
                                        from</label><input asp-for="EffectiveFrom" type="date" class="form-control" /></div>
                                    </div>
                                    <div class="mb-3 mt-3"><label asp-for="RevisionReason" class="form-label">Revision
                                        reason</label><textarea asp-for="RevisionReason" class="form-control"
                                                                maxlength="200"></textarea></div><button class="btn btn-primary" type="submit">Save
                                        revision</button> <a class="btn btn-outline-secondary" asp-action="SalaryMaster">Cancel</a>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

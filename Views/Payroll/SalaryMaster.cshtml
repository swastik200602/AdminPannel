@model IEnumerable<AdminPannel.Models.SalaryMasterModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var filter = ViewBag.Filter as AdminPannel.Models.SalaryMasterFilterModel ?? new(); var selected = filter.EmployeeID.HasValue ? employees.FirstOrDefault(e => e.EmployeeID == filter.EmployeeID.Value) : null; }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start"><div><h1 class="fs-3 mb-1">Salary Master</h1><p class="text-body-secondary mb-0">Manage current employee compensation and salary revisions.</p></div><a asp-action="CreateSalaryRevision" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New revision</a></div></div>
<div class="app-content"><div class="container-fluid">
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> } @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success">@TempData["PayrollMessage"]</div> }
@if (selected != null) { @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = selected.EmployeeID, FullName = selected.FullName, EmployeeCode = selected.EmployeeCode, ProfileImage = selected.ProfileImage, DesignationName = selected.DesignationName, DepartmentName = selected.DepartmentName, OfficeName = selected.OfficeName, JoiningDate = selected.JoiningDate, IsActive = selected.IsActive }) }
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-6"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID" selected="@(filter.EmployeeID == e.EmployeeID)">@e.FullName — @e.EmployeeCode</option> }</select></div><div class="col-lg-3"><label class="form-label">Status</label><select name="IsActive" class="form-select"><option value="true" selected="@(filter.IsActive == true)">Active</option><option value="false" selected="@(filter.IsActive == false)">Inactive</option><option value="" selected="@(filter.IsActive == null)">All status</option></select></div><div class="col-lg-3 d-flex gap-2"><button class="btn btn-primary">Filter</button><a asp-action="SalaryMaster" class="btn btn-outline-secondary">Clear</a></div></form></div></div>
@if (!Model.Any()) { <div class="alert alert-info">No salary records found.</div> } else { <div class="card"><div class="card-header"><h2 class="h5 mb-0">Employee compensation</h2></div><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Role context</th><th class="text-end">Basic</th><th class="text-end">Allowance</th><th class="text-end">Bonus</th><th class="text-end">Deduction</th><th class="text-end">Tax</th><th>Effective</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var s in Model) { var e = employees.FirstOrDefault(x => x.EmployeeID == s.EmployeeID); <tr><td><div class="fw-semibold">@(s.EmployeeName ?? e?.FullName ?? "Employee")</div><small class="text-body-secondary">@(s.EmployeeCode ?? e?.EmployeeCode ?? $"#{s.EmployeeID}")</small></td><td><div>@(e?.DesignationName ?? "-")</div><small class="text-body-secondary">@(e?.DepartmentName ?? "-")</small></td><td class="text-end">₹@s.BasicSalary.ToString("N0")</td><td class="text-end">₹@s.Allowance.ToString("N0")</td><td class="text-end">₹@s.Bonus.ToString("N0")</td><td class="text-end">₹@s.Deduction.ToString("N0")</td><td class="text-end">₹@s.Tax.ToString("N0")</td><td><div>@s.EffectiveFrom.ToString("dd-MMM-yyyy")</div><small class="text-body-secondary">@(s.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Present")</small></td><td><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "Active" : "Historical")</span></td><td><a asp-action="SalaryHistory" asp-route-employeeId="@s.EmployeeID" class="btn btn-sm btn-outline-info">History</a></td></tr> }</tbody></table></div></div> }
</div></div>

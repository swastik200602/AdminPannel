@model AdminPannel.Models.PayrollModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">Edit Payroll</h1></div></div><div class="app-content"><div class="container-fluid"><div class="card"><div class="card-body"><div asp-validation-summary="All" class="text-danger"></div><form asp-action="Edit" asp-route-id="@Model.PayrollID" method="post">@Html.AntiForgeryToken()<p class="text-muted">Period: @Model.PayrollMonth/@Model.PayrollYear. Net salary is calculated by SQL and cannot be edited.</p><div class="row g-3"><div class="col-md-4"><label asp-for="BasicSalary" class="form-label">Basic salary</label><input asp-for="BasicSalary" class="form-control" /></div><div class="col-md-4"><label asp-for="Allowance" class="form-label">Allowance</label><input asp-for="Allowance" class="form-control" /></div><div class="col-md-4"><label asp-for="Bonus" class="form-label">Bonus</label><input asp-for="Bonus" class="form-control" /></div><div class="col-md-4"><label asp-for="Deduction" class="form-label">Deduction</label><input asp-for="Deduction" class="form-control" /></div><div class="col-md-4"><label asp-for="Tax" class="form-label">Tax</label><input asp-for="Tax" class="form-control" /></div><div class="col-md-4"><label asp-for="PaymentStatus" class="form-label">Status</label><select asp-for="PaymentStatus" class="form-select"><option>Pending</option><option>Processing</option><option>Paid</option><option>Failed</option></select></div><div class="col-md-4"><label asp-for="PaymentDate" class="form-label">Payment date</label><input asp-for="PaymentDate" type="date" class="form-control" /></div></div><div class="mt-3"><label asp-for="Remarks" class="form-label">Remarks</label><textarea asp-for="Remarks" class="form-control"></textarea></div><button class="btn btn-primary mt-3">Save</button> <a class="btn btn-outline-secondary mt-3" asp-action="Index">Cancel</a></form></div></div></div></div>

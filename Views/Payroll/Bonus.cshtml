@model IEnumerable<AdminPannel.Models.BonusModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var filter = ViewBag.Filter as AdminPannel.Models.BonusFilterModel ?? new(); var selected = filter.EmployeeID.HasValue ? employees.FirstOrDefault(e => e.EmployeeID == filter.EmployeeID.Value) : null; }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start"><div><h1 class="fs-3 mb-1">Bonuses</h1><p class="text-body-secondary mb-0">Manage employee incentives and bonus transactions.</p></div><a asp-action="CreateBonus" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New bonus</a></div></div><div class="app-content"><div class="container-fluid">
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> } @if (TempData["PayrollError"] != null) { <div class="alert alert-danger">@TempData["PayrollError"]</div> } @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success">@TempData["PayrollMessage"]</div> }
@if (selected != null) { @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = selected.EmployeeID, FullName = selected.FullName, EmployeeCode = selected.EmployeeCode, ProfileImage = selected.ProfileImage, DesignationName = selected.DesignationName, DepartmentName = selected.DepartmentName, OfficeName = selected.OfficeName, JoiningDate = selected.JoiningDate, IsActive = selected.IsActive }) }
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-4"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID" selected="@(filter.EmployeeID == e.EmployeeID)">@e.FullName — @e.EmployeeCode</option> }</select></div><div class="col-lg-2"><label class="form-label">Month</label><input name="BonusMonth" value="@filter.BonusMonth" type="number" min="1" max="12" class="form-control" /></div><div class="col-lg-2"><label class="form-label">Year</label><input name="BonusYear" value="@filter.BonusYear" type="number" min="2000" class="form-control" /></div><div class="col-lg-2"><label class="form-label">Status</label><select name="Status" class="form-select"><option value="">All</option><option selected="@(filter.Status == "Pending")">Pending</option><option selected="@(filter.Status == "Applied")">Applied</option><option selected="@(filter.Status == "Cancelled")">Cancelled</option></select></div><div class="col-lg-2 d-flex gap-2"><button class="btn btn-primary">Filter</button><a asp-action="Bonus" class="btn btn-outline-secondary">Clear</a></div></form></div></div>
@if (!Model.Any()) { <div class="alert alert-info">No bonuses found.</div> } else { <div class="card"><div class="card-header"><h2 class="h5 mb-0">Bonus transactions</h2></div><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Context</th><th class="text-end">Amount</th><th>Period</th><th>Type / reason</th><th>Status</th><th>Paid date</th><th>Created</th><th>Actions</th></tr></thead><tbody>@foreach (var b in Model) { var e = employees.FirstOrDefault(x => x.EmployeeID == b.EmployeeID); var badge = b.Status == "Pending" ? "bg-warning text-dark" : b.Status == "Applied" ? "bg-success" : "bg-secondary"; <tr><td><div class="fw-semibold">@(b.EmployeeName ?? e?.FullName ?? "Employee")</div><small class="text-body-secondary">@(b.EmployeeCode ?? e?.EmployeeCode ?? $"#{b.EmployeeID}")</small></td><td><div>@(e?.DesignationName ?? "-")</div><small class="text-body-secondary">@(e?.DepartmentName ?? "-")</small></td><td class="text-end fw-semibold">₹@b.BonusAmount.ToString("N0")</td><td>@(new DateTime(b.BonusYear, b.BonusMonth, 1).ToString("MMM yyyy"))</td><td><div>@(b.BonusType ?? "-")</div><small class="text-body-secondary">@(b.Reason ?? "-")</small></td><td><span class="badge @badge">@(b.Status ?? "Unknown")</span></td><td>@(b.PaidDate?.ToString("dd-MMM-yyyy") ?? "-")</td><td>@(b.CreatedAt?.ToString("dd-MMM-yyyy") ?? "-")</td><td class="text-nowrap">@if (b.Status == "Pending") { <a asp-action="EditBonus" asp-route-id="@b.BonusID" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="CancelBonus" method="post" class="d-inline" onsubmit="return confirm('Cancel this pending bonus?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.BonusID" /><button class="btn btn-sm btn-outline-danger">Cancel</button></form> } else { <span class="small text-body-secondary">Read-only</span> }</td></tr> }</tbody></table></div></div> }
</div></div>

@model IEnumerable<AdminPannel.Models.SalaryAdvanceModel>
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employees = ViewBag.Employees as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var filter = ViewBag.Filter as AdminPannel.Models.SalaryAdvanceFilterModel ?? new(); var selected = filter.EmployeeID.HasValue ? employees.FirstOrDefault(e => e.EmployeeID == filter.EmployeeID.Value) : null; }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start"><div><h1 class="fs-3 mb-1">Advances &amp; Loans</h1><p class="text-body-secondary mb-0">Manage employee salary advances, loans, and recovery.</p></div><a asp-action="CreateAdvance" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>New advance</a></div></div><div class="app-content"><div class="container-fluid">
@if (ViewBag.Error != null) { <div class="alert alert-danger">@ViewBag.Error</div> } @if (TempData["PayrollError"] != null) { <div class="alert alert-danger">@TempData["PayrollError"]</div> } @if (TempData["PayrollMessage"] != null) { <div class="alert alert-success">@TempData["PayrollMessage"]</div> }
@if (selected != null) { @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = selected.EmployeeID, FullName = selected.FullName, EmployeeCode = selected.EmployeeCode, ProfileImage = selected.ProfileImage, DesignationName = selected.DesignationName, DepartmentName = selected.DepartmentName, OfficeName = selected.OfficeName, JoiningDate = selected.JoiningDate, IsActive = selected.IsActive }) }
<div class="card mb-3"><div class="card-body"><form method="get" class="row g-2 align-items-end"><div class="col-lg-5"><label class="form-label">Employee</label><select name="EmployeeID" class="form-select"><option value="">All employees</option>@foreach (var e in employees) { <option value="@e.EmployeeID" selected="@(filter.EmployeeID == e.EmployeeID)">@e.FullName — @e.EmployeeCode</option> }</select></div><div class="col-lg-2"><label class="form-label">Type</label><select name="TransactionType" class="form-select"><option value="">All types</option><option selected="@(filter.TransactionType == "Advance")">Advance</option><option selected="@(filter.TransactionType == "Loan")">Loan</option></select></div><div class="col-lg-2"><label class="form-label">Status</label><select name="Status" class="form-select"><option value="">All</option><option selected="@(filter.Status == "Active")">Active</option><option selected="@(filter.Status == "Completed")">Completed</option><option selected="@(filter.Status == "Cancelled")">Cancelled</option></select></div><div class="col-lg-3 d-flex gap-2"><button class="btn btn-primary">Filter</button><a asp-action="Advance" class="btn btn-outline-secondary">Clear</a></div></form></div></div>
@if (!Model.Any()) { <div class="alert alert-info">No advances or loans found.</div> } else { <div class="card"><div class="card-header"><h2 class="h5 mb-0">Advance and loan recovery</h2></div><div class="card-body table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Employee</th><th>Context</th><th>Type</th><th class="text-end">Total</th><th class="text-end">Recovered</th><th class="text-end">Outstanding</th><th class="text-end">Monthly recovery</th><th>Dates</th><th>Status</th><th>Actions</th></tr></thead><tbody>@foreach (var a in Model) { var e = employees.FirstOrDefault(x => x.EmployeeID == a.EmployeeID); var badge = a.Status == "Active" ? "bg-warning text-dark" : a.Status == "Completed" ? "bg-success" : "bg-secondary"; var progress = a.TotalAmount > 0 ? Math.Clamp((int)Math.Round(a.RecoveredAmount / a.TotalAmount * 100), 0, 100) : 0; <tr><td><div class="fw-semibold">@(a.EmployeeName ?? e?.FullName ?? "Employee")</div><small class="text-body-secondary">@(a.EmployeeCode ?? e?.EmployeeCode ?? $"#{a.EmployeeID}")</small></td><td><div>@(e?.DesignationName ?? "-")</div><small class="text-body-secondary">@(e?.DepartmentName ?? "-")</small></td><td><span class="badge bg-light text-dark">@a.TransactionType</span></td><td class="text-end">₹@a.TotalAmount.ToString("N0")</td><td class="text-end">₹@a.RecoveredAmount.ToString("N0")</td><td class="text-end fw-bold">₹@a.OutstandingAmount.ToString("N0")<div class="progress mt-1" style="height:5px;min-width:90px"><div class="progress-bar @(a.Status == "Completed" ? "bg-success" : "bg-primary")" style="width:@progress%"></div></div><small class="text-body-secondary">@progress% recovered</small></td><td class="text-end">₹@a.MonthlyRecoveryAmount.ToString("N0")</td><td><div>@a.IssueDate.ToString("dd-MMM-yyyy")</div><small class="text-body-secondary">Starts: @a.RecoveryStartMonth/@a.RecoveryStartYear</small></td><td><span class="badge @badge">@(a.Status ?? "Unknown")</span></td><td class="text-nowrap">@if (a.Status == "Active") { <a asp-action="EditAdvance" asp-route-id="@a.SalaryAdvanceID" class="btn btn-sm btn-outline-primary">Edit</a> <form asp-action="CancelAdvance" method="post" class="d-inline" onsubmit="return confirm('Cancel this active advance/loan?');">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.SalaryAdvanceID" /><button class="btn btn-sm btn-outline-danger">Cancel</button></form> } else { <span class="small text-body-secondary">Read-only</span> }</td></tr> }</tbody></table></div></div> }
</div></div>

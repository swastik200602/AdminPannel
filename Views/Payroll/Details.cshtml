@model AdminPannel.Models.PayrollModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="app-content-header"><div class="container-fluid"><h1 class="fs-3">@(ViewBag.EmployeeContext?.FullName ?? Model.EmployeeName ?? "Employee") — Payroll Details</h1></div></div>
<div class="app-content"><div class="container-fluid">
    @if (ViewBag.EmployeeContext is AdminPannel.Models.EmployeeContextModel employeeContext) { @await Html.PartialAsync("_EmployeeContextCard", employeeContext) }
    <div class="card mb-3"><div class="card-body"><div class="row g-3"><div class="col-md-4"><span class="text-body-secondary">Payroll period</span><div class="fs-5 fw-semibold">@Model.PayrollMonth/@Model.PayrollYear</div></div><div class="col-md-4"><span class="text-body-secondary">Payment status</span><div><span class="badge bg-info">@Model.PaymentStatus</span></div></div><div class="col-md-4"><span class="text-body-secondary">Payment date</span><div class="fs-5">@(Model.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</div></div></div></div></div>
    <div class="row g-3"><div class="col-md-6"><div class="card h-100"><div class="card-header"><h5 class="mb-0">Earnings</h5></div><div class="card-body"><div class="d-flex justify-content-between"><span>Basic</span><strong>@Model.BasicSalary.ToString("N2")</strong></div><div class="d-flex justify-content-between"><span>Allowance</span><strong>@Model.Allowance.ToString("N2")</strong></div><div class="d-flex justify-content-between"><span>Bonus</span><strong>@Model.Bonus.ToString("N2")</strong></div><hr /><div class="d-flex justify-content-between fs-5"><strong>Gross earnings</strong><strong>@((Model.BasicSalary + Model.Allowance + Model.Bonus).ToString("N2"))</strong></div></div></div></div><div class="col-md-6"><div class="card h-100"><div class="card-header"><h5 class="mb-0">Deductions</h5></div><div class="card-body"><div class="d-flex justify-content-between"><span>Deduction</span><strong>@Model.Deduction.ToString("N2")</strong></div><div class="d-flex justify-content-between"><span>Tax</span><strong>@Model.Tax.ToString("N2")</strong></div><div class="d-flex justify-content-between"><span>Advance recovery</span><strong>@Model.AdvanceRecovery.ToString("N2")</strong></div><hr /><div class="d-flex justify-content-between fs-5"><strong>Total deductions</strong><strong>@((Model.Deduction + Model.Tax + Model.AdvanceRecovery).ToString("N2"))</strong></div></div></div></div></div>
    <div class="card mt-3"><div class="card-body d-flex justify-content-between align-items-center"><span class="fs-5">Net salary</span><strong class="fs-3 text-success">@Model.NetSalary.ToString("N2")</strong></div></div>
    @if (User.IsInRole("Admin") || User.IsInRole("HR")) { <div class="card mt-3"><div class="card-body"><form asp-action="UpdatePaymentStatus" method="post" class="row g-2">@Html.AntiForgeryToken()<input type="hidden" name="PayrollID" value="@Model.PayrollID" /><div class="col-md-3"><select name="PaymentStatus" class="form-select"><option>Pending</option><option>Processing</option><option>Paid</option><option>Failed</option></select></div><div class="col-md-3"><input name="PaymentDate" type="date" class="form-control" /></div><div class="col-md-4"><input name="Remarks" class="form-control" placeholder="Remarks" /></div><div class="col-md-2"><button class="btn btn-primary" type="submit">Update status</button></div></form></div></div> }
</div></div>

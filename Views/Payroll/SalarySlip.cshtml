@model AdminPannel.Models.SalarySlipModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employee = ViewBag.EmployeeContext as AdminPannel.Models.EmployeeContextModel; var period = new DateTime(Model.PayrollYear, Model.PayrollMonth, 1); }
<style>@@media print { .no-print { display:none!important; } .app-content-header, .main-sidebar, .app-header, .app-footer { display:none!important; } .app-content { margin:0!important; } .card { border:0!important; box-shadow:none!important; } }</style>
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-center"><div><div class="text-uppercase small text-body-secondary">Payroll document</div><h1 class="fs-3 mb-0">SALARY SLIP</h1><div class="fw-semibold">@period.ToString("MMMM yyyy")</div></div><button class="btn btn-outline-secondary no-print" onclick="window.print()"><i class="bi bi-printer me-1"></i>Print</button></div></div>
<div class="app-content"><div class="container-fluid"><div class="card shadow-sm"><div class="card-body p-4">
@if (employee != null) { @await Html.PartialAsync("_EmployeeContextCard", employee) }
<div class="row g-3 border-top border-bottom py-3 mb-4"><div class="col-md-4"><div class="small text-body-secondary">Payroll period</div><strong>@period.ToString("MMMM yyyy")</strong></div><div class="col-md-4"><div class="small text-body-secondary">Payment status</div><span class="badge @(Model.PaymentStatus?.Equals("Paid", StringComparison.OrdinalIgnoreCase) == true ? "bg-success" : "bg-warning text-dark")">@(Model.PaymentStatus ?? "-")</span></div><div class="col-md-4"><div class="small text-body-secondary">Payment date</div><strong>@(Model.PaymentDate?.ToString("dd-MMM-yyyy") ?? "Not paid")</strong></div></div>
<div class="row g-4"><div class="col-md-6"><div class="card h-100 border"><div class="card-header"><h2 class="h5 mb-0">Earnings</h2></div><div class="card-body"><div class="d-flex justify-content-between py-2"><span>Basic salary</span><strong>₹@Model.BasicSalary.ToString("N0")</strong></div><div class="d-flex justify-content-between py-2"><span>Allowance</span><strong>₹@Model.Allowance.ToString("N0")</strong></div><div class="d-flex justify-content-between py-2"><span>Bonus</span><strong>₹@Model.Bonus.ToString("N0")</strong></div><div class="d-flex justify-content-between border-top mt-2 pt-3"><strong>Gross earnings</strong><strong>₹@Model.GrossEarnings.ToString("N0")</strong></div></div></div></div><div class="col-md-6"><div class="card h-100 border"><div class="card-header"><h2 class="h5 mb-0">Deductions</h2></div><div class="card-body"><div class="d-flex justify-content-between py-2"><span>Deduction</span><strong>₹@Model.Deduction.ToString("N0")</strong></div><div class="d-flex justify-content-between py-2"><span>Tax / TDS</span><strong>₹@Model.Tax.ToString("N0")</strong></div><div class="d-flex justify-content-between py-2"><span>Advance recovery</span><strong>₹@Model.AdvanceRecovery.ToString("N0")</strong></div><div class="d-flex justify-content-between border-top mt-2 pt-3"><strong>Total deductions</strong><strong>₹@Model.TotalDeductions.ToString("N0")</strong></div></div></div></div></div>
<div class="d-flex justify-content-between align-items-center bg-primary-subtle rounded p-3 mt-4"><span class="fs-5 fw-semibold">NET SALARY</span><span class="fs-3 fw-bold">₹@Model.NetSalary.ToString("N0")</span></div>
</div></div></div></div>

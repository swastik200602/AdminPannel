@model AdminPannel.Models.EmployeeDocumentsPageModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employee = Model.Employee; }

<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start gap-3"><div><div class="text-uppercase small text-primary fw-semibold">Employee onboarding</div><h1 class="fs-3 mb-1">@employee.FullName — Documents</h1><p class="text-body-secondary mb-0">Collect and review the documents required for this employee's record.</p></div><a asp-action="Onboarding" asp-route-employeeId="@employee.EmployeeID" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back to onboarding</a></div></div>
<div class="app-content"><div class="container-fluid">
    @if (TempData["OnboardingError"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["OnboardingError"]</div> }
    @if (TempData["OnboardingMessage"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["OnboardingMessage"]</div> }
    @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = employee.EmployeeID, FullName = employee.FullName, EmployeeCode = employee.EmployeeCode, ProfileImage = employee.ProfileImage, DesignationName = employee.DesignationName, DepartmentName = employee.DepartmentName, OfficeName = employee.OfficeName, JoiningDate = employee.JoiningDate, IsActive = employee.IsActive })
    <div class="card border-primary mb-3"><div class="card-header"><h2 class="h5 mb-1">Upload employee document</h2><p class="small text-body-secondary mb-0">Files are stored privately and can only be downloaded through an authorized HR/Admin action.</p></div><div class="card-body"><form asp-action="UploadDocument" asp-route-employeeId="@employee.EmployeeID" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">@Html.AntiForgeryToken()<div class="col-md-3"><label class="form-label">Document type</label><select name="documentType" class="form-select"><option>Identity proof</option><option>Address proof</option><option>Qualification</option><option>Employment proof</option><option>Other</option></select></div><div class="col-md-4"><label class="form-label">Choose file <span class="text-danger">*</span></label><input type="file" name="document" class="form-control" accept=".pdf,.jpg,.jpeg,.png,.doc,.docx" required /><div class="form-text">PDF, JPG, PNG, DOC or DOCX up to 10 MB.</div></div><div class="col-md-2"><label class="form-label">Expiry date</label><input type="date" name="expiryDate" class="form-control" /></div><div class="col-md-3"><label class="form-label">Remarks</label><div class="input-group"><input name="remarks" class="form-control" maxlength="500" placeholder="Optional note" /><button class="btn btn-primary" type="submit"><i class="bi bi-cloud-upload me-1"></i>Upload document</button></div></div></form></div></div>
    <div class="card"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">Document register</h2><p class="small text-body-secondary mb-0">Uploaded files remain pending until an authorized reviewer verifies them.</p></div><span class="badge text-bg-secondary">@Model.Documents.Count document@(Model.Documents.Count == 1 ? "" : "s")</span></div><div class="card-body p-0">@if (!Model.Documents.Any()) { <div class="text-center py-5 text-body-secondary"><i class="bi bi-file-earmark-arrow-up fs-1 d-block mb-2"></i><h3 class="h5">No documents uploaded</h3><p class="mb-0">Upload the first document using the form above.</p></div> } else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Document</th><th>Type</th><th>Uploaded</th><th>Expiry</th><th>Review status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var doc in Model.Documents) { <tr><td><div class="fw-semibold">@doc.DocumentName</div><div class="small text-body-secondary">@doc.FileExtension.ToUpperInvariant() · @(doc.FileSizeKB?.ToString("N0") ?? "0") KB</div></td><td>@doc.DocumentType</td><td>@doc.UploadedDate.ToLocalTime().ToString("dd-MMM-yyyy HH:mm")</td><td>@(doc.ExpiryDate?.ToString("dd-MMM-yyyy") ?? "No expiry")</td><td><span class="badge @(doc.IsVerified ? "text-bg-success" : "text-bg-warning")">@(doc.IsVerified ? "Verified" : "Pending review")</span></td><td class="text-end text-nowrap"><a asp-action="DownloadDocument" asp-route-employeeId="@employee.EmployeeID" asp-route-documentId="@doc.DocumentID" class="btn btn-sm btn-outline-primary" title="Download"><i class="bi bi-download"></i></a> <form asp-action="DeleteDocument" asp-route-employeeId="@employee.EmployeeID" asp-route-documentId="@doc.DocumentID" method="post" class="d-inline" onsubmit="return confirm('Delete this document?');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button></form></td></tr> }</tbody></table></div> }</div></div>
</div></div>
@if (Model.Documents.Any(x => !x.IsVerified)) { <div class="container-fluid"><div class="card border-warning"><div class="card-header"><h2 class="h6 mb-0"><i class="bi bi-shield-check me-2"></i>Review queue</h2></div><div class="card-body"><p class="small text-body-secondary">Authorized HR/Admin reviewers should verify each document after checking the original.</p>@foreach (var pending in Model.Documents.Where(x => !x.IsVerified)) { <div class="d-flex justify-content-between align-items-center border-bottom py-2"><span>@pending.DocumentName <span class="small text-body-secondary">(@pending.DocumentType)</span></span><form asp-action="VerifyDocument" asp-route-employeeId="@employee.EmployeeID" asp-route-documentId="@pending.DocumentID" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-success" type="submit"><i class="bi bi-check2-circle me-1"></i>Mark verified</button></form></div> }</div></div></div> }

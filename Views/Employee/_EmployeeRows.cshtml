@model IEnumerable<AdminPannel.Models.EmployeeResponse>
@{ var canManage = User.IsInRole("Admin") || User.IsInRole("HR"); var isEmployee = User.IsInRole("Employee"); }
@if (Model == null || !Model.Any()) { <div class="text-center py-5 text-body-secondary"><i class="bi bi-people fs-1 d-block mb-2"></i><h3 class="h5">No employees found</h3><p class="mb-0">Try changing the filters or create a new employee profile.</p></div> }
else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Employee</th><th>Work context</th><th>Contact</th><th>Employment</th><th>Onboarding status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach(var item in Model){var onboardingClass=item.OnboardingStatus=="Ready for payroll"?"text-bg-success":item.OnboardingStatus=="In progress"?"text-bg-warning":"text-bg-secondary";<tr><td><div class="d-flex align-items-center gap-3">@if(!string.IsNullOrWhiteSpace(item.ProfileImage)){<img src="@item.ProfileImage" alt="@item.FullName" class="rounded-circle" style="width:48px;height:48px;object-fit:cover" />}else{<div class="rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-semibold" style="width:48px;height:48px">@(string.IsNullOrWhiteSpace(item.FirstName)?"?":item.FirstName.Substring(0,1).ToUpperInvariant())</div>}<div><a asp-action="Details" asp-route-id="@item.EmployeeID" class="fw-semibold text-reset text-decoration-none">@item.FullName</a><div class="small text-body-secondary">@item.EmployeeCode</div></div></div></td><td><div class="fw-semibold">@(item.DesignationName ?? "Designation not assigned")</div><div class="small text-body-secondary">@(item.DepartmentName ?? "Department not assigned")@(string.IsNullOrWhiteSpace(item.OfficeName)?"":" · "+item.OfficeName)</div></td><td><div>@item.Email</div><div class="small text-body-secondary">@item.PhoneNumber</div></td><td><div>@item.EmploymentType</div><div class="small text-body-secondary">Joined @(item.JoiningDate?.ToString("dd-MMM-yyyy") ?? "-")</div></td><td><span class="badge @onboardingClass">@item.OnboardingStatus</span><div class="small text-body-secondary mt-1">@item.OnboardingCompleted/@item.OnboardingTotal steps</div><a asp-action="Onboarding" asp-route-employeeId="@item.EmployeeID" class="btn btn-sm btn-outline-primary mt-2"><i class="bi bi-list-check me-1"></i>Open workspace</a></td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@item.EmployeeID" class="btn btn-sm btn-outline-info" title="View profile"><i class="bi bi-person-vcard"></i></a>@if(canManage){<a asp-action="Edit" asp-route-id="@item.EmployeeID" class="btn btn-sm btn-outline-success ms-1" title="Edit profile"><i class="bi bi-pencil"></i></a><form asp-action="Delete" asp-route-id="@item.EmployeeID" method="post" class="d-inline ms-1" onsubmit="return confirm('Delete this employee?');">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger" title="Delete employee"><i class="bi bi-trash"></i></button></form>}else if(isEmployee){<a asp-action="EditSelf" class="btn btn-sm btn-outline-success ms-1">Edit profile</a>}</td></tr>}</tbody></table></div> }

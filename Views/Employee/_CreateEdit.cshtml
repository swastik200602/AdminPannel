@model AdminPannel.Models.EmployeeRequest
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    var isEdit = Model.EmployeeID > 0;
    ViewData["Title"] = isEdit ? "Edit Employee" : "Create Employee";
    var departments = ViewBag.Departments as IEnumerable<AdminPannel.Models.DepartmentResponse> ?? Enumerable.Empty<AdminPannel.Models.DepartmentResponse>();
    var designations = ViewBag.Designations as IEnumerable<AdminPannel.Models.DesignationResponse> ?? Enumerable.Empty<AdminPannel.Models.DesignationResponse>();
    var offices = ViewBag.OfficeBranches as IEnumerable<AdminPannel.Models.OfficeBranchResponse> ?? Enumerable.Empty<AdminPannel.Models.OfficeBranchResponse>();
    var shifts = ViewBag.Shifts as IEnumerable<AdminPannel.Models.ShiftResponse> ?? Enumerable.Empty<AdminPannel.Models.ShiftResponse>();
    var managers = ViewBag.Managers as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>();
    var roles = ViewBag.Roles as IEnumerable<AdminPannel.Models.RoleResponse> ?? Enumerable.Empty<AdminPannel.Models.RoleResponse>();
}

<div class="app-content-header">
    <div class="container-fluid"><h1 class="mb-0 fs-3">@ViewData["Title"]</h1></div>
</div>
<div class="app-content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-body">
                <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? Model.EmployeeID : null)" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-md-3"><label asp-for="EmployeeCode" class="form-label"></label><input asp-for="EmployeeCode" class="form-control" /><span asp-validation-for="EmployeeCode" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /><span asp-validation-for="FirstName" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /><span asp-validation-for="LastName" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="Gender" class="form-label"></label><input asp-for="Gender" class="form-control" /></div>
                        <div class="col-md-3"><label asp-for="DateOfBirth" class="form-label"></label><input asp-for="DateOfBirth" type="date" class="form-control" /></div>
                        <div class="col-md-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /><span asp-validation-for="PhoneNumber" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="EmergencyContact" class="form-label"></label><input asp-for="EmergencyContact" class="form-control" /></div>
                        <div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /><span asp-validation-for="Address" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /><span asp-validation-for="City" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="State" class="form-label"></label><input asp-for="State" class="form-control" /><span asp-validation-for="State" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /><span asp-validation-for="Country" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="PostalCode" class="form-label"></label><input asp-for="PostalCode" class="form-control" /><span asp-validation-for="PostalCode" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="DepartmentID" class="form-label">Department</label><select asp-for="DepartmentID" class="form-select"><option value="0">Select</option>@foreach (var item in departments) { <option value="@item.DepartmentID">@item.DepartmentName</option> }</select><span asp-validation-for="DepartmentID" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="DesignationID" class="form-label">Designation</label><select asp-for="DesignationID" class="form-select"><option value="0">Select</option>@foreach (var item in designations) { <option value="@item.DesignationID">@item.DesignationName</option> }</select><span asp-validation-for="DesignationID" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="OfficeLocationID" class="form-label">Office</label><select asp-for="OfficeLocationID" class="form-select"><option value="0">Select</option>@foreach (var item in offices) { <option value="@item.OfficeLocationID">@item.OfficeName</option> }</select><span asp-validation-for="OfficeLocationID" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="ManagerID" class="form-label">Manager</label><select asp-for="ManagerID" class="form-select"><option value="">None</option>@foreach (var item in managers) { <option value="@item.EmployeeID">@item.FullName (@item.EmployeeCode)</option> }</select></div>
                        <div class="col-md-3"><label asp-for="JoiningDate" class="form-label"></label><input asp-for="JoiningDate" type="date" class="form-control" /><span asp-validation-for="JoiningDate" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="EmploymentType" class="form-label"></label><input asp-for="EmploymentType" class="form-control" /><span asp-validation-for="EmploymentType" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="BasicSalary" class="form-label"></label><input asp-for="BasicSalary" type="number" step="0.01" min="0" class="form-control" /><span asp-validation-for="BasicSalary" class="text-danger"></span></div>
                        <div class="col-md-3"><label asp-for="ShiftID" class="form-label">Shift</label><select asp-for="ShiftID" class="form-select"><option value="">None</option>@foreach (var item in shifts) { <option value="@item.ShiftID">@item.ShiftName</option> }</select></div>
                        <div class="col-md-4"><label asp-for="ProfileImageFile" class="form-label">Profile image</label><input asp-for="ProfileImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control" /><small class="text-muted">JPG, PNG, or WEBP up to 5 MB.</small></div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="col-md-3"><label asp-for="RoleID" class="form-label">Role</label><select asp-for="RoleID" class="form-select"><option value="0">Select</option>@foreach (var item in roles) { <option value="@item.RoleID">@item.RoleName</option> }</select><span asp-validation-for="RoleID" class="text-danger"></span></div>
                        }
                    </div>
                    <div class="mt-4">
                        <button type="submit" class="btn btn-primary">@(isEdit ? "Update" : "Create")</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@model AdminPannel.Models.EmployeeRequest
@{ var isEdit=Model.EmployeeID>0; ViewData["Title"]=isEdit?"Edit Employee":"Create Employee"; var departments=ViewBag.Departments as IEnumerable<AdminPannel.Models.DepartmentResponse> ?? Enumerable.Empty<AdminPannel.Models.DepartmentResponse>(); var designations=ViewBag.Designations as IEnumerable<AdminPannel.Models.DesignationResponse> ?? Enumerable.Empty<AdminPannel.Models.DesignationResponse>(); var offices=ViewBag.OfficeBranches as IEnumerable<AdminPannel.Models.OfficeBranchResponse> ?? Enumerable.Empty<AdminPannel.Models.OfficeBranchResponse>(); var shifts=ViewBag.Shifts as IEnumerable<AdminPannel.Models.ShiftResponse> ?? Enumerable.Empty<AdminPannel.Models.ShiftResponse>(); var managers=ViewBag.Managers as IEnumerable<AdminPannel.Models.EmployeeResponse> ?? Enumerable.Empty<AdminPannel.Models.EmployeeResponse>(); var roles=ViewBag.Roles as IEnumerable<AdminPannel.Models.RoleResponse> ?? Enumerable.Empty<AdminPannel.Models.RoleResponse>(); var states=ViewBag.IndiaStates as IEnumerable<AdminPannel.Models.LocationLookup> ?? Enumerable.Empty<AdminPannel.Models.LocationLookup>(); var cities=ViewBag.IndiaCities as IEnumerable<AdminPannel.Models.LocationLookup> ?? Enumerable.Empty<AdminPannel.Models.LocationLookup>(); var maxDob=DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd"); var today=DateTime.Today.ToString("yyyy-MM-dd"); }
<div class="app-content-header"><div class="container-fluid"><h1 class="mb-1 fs-3">@ViewData["Title"]</h1><p class="text-muted">Create the employee profile first; salary and tax are completed in onboarding.</p></div></div>
<div class="app-content"><div class="container-fluid"><form asp-action="@(isEdit?"Edit":"Create")" asp-route-id="@(isEdit?Model.EmployeeID:null)" method="post" enctype="multipart/form-data" id="employeeForm">@Html.AntiForgeryToken()@if(!ViewData.ModelState.IsValid){<div asp-validation-summary="All" class="alert alert-danger"></div>}@if(isEdit){<input type="hidden" asp-for="EmployeeCode"/>}
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Personal Information</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="FirstName" class="form-label">First name <span class="text-danger">*</span></label><input asp-for="FirstName" class="form-control" required/><span asp-validation-for="FirstName" class="text-danger"/></div><div class="col-md-4"><label asp-for="LastName" class="form-label">Last name <span class="text-danger">*</span></label><input asp-for="LastName" class="form-control" required/><span asp-validation-for="LastName" class="text-danger"/></div><div class="col-md-4"><label asp-for="Gender" class="form-label">Gender <span class="text-danger">*</span></label><select asp-for="Gender" class="form-select" required><option value="">Select gender</option><option>Male</option><option>Female</option><option>Other</option></select><span asp-validation-for="Gender" class="text-danger"/></div><div class="col-md-4"><label asp-for="DateOfBirth" class="form-label">Date of birth <span class="text-danger">*</span></label><input asp-for="DateOfBirth" type="date" max="@maxDob" class="form-control" required/><small class="text-muted">Minimum age: 18.</small><span asp-validation-for="DateOfBirth" class="text-danger d-block"/></div></div></div></div>
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Contact Information</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="Email" class="form-label">Email <span class="text-danger">*</span></label><input asp-for="Email" type="email" class="form-control" required/><span asp-validation-for="Email" class="text-danger"/></div><div class="col-md-4"><label asp-for="PhoneNumber" class="form-label">Phone number <span class="text-danger">*</span></label><input asp-for="PhoneNumber" class="form-control" pattern="\+?[0-9]{10,15}" required/><span asp-validation-for="PhoneNumber" class="text-danger"/></div><div class="col-md-4"><label asp-for="EmergencyContact" class="form-label">Emergency contact</label><input asp-for="EmergencyContact" class="form-control" pattern="\+?[0-9]{10,15}"/><span asp-validation-for="EmergencyContact" class="text-danger"/></div></div></div></div>
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Address</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-6"><label asp-for="Address" class="form-label">Address <span class="text-danger">*</span></label><input asp-for="Address" class="form-control" required/><span asp-validation-for="Address" class="text-danger"/></div><div class="col-md-3"><label asp-for="Country" class="form-label">Country <span class="text-danger">*</span></label><input asp-for="Country" class="form-control" value="@(string.IsNullOrWhiteSpace(Model.Country)?"India":Model.Country)" readonly/><span asp-validation-for="Country" class="text-danger"/></div><div class="col-md-3"><label asp-for="State" class="form-label">State <span class="text-danger">*</span></label><select asp-for="State" class="form-select" id="State" required><option value="">Select state</option>@foreach(var x in states){<option value="@x.StateName">@x.StateName</option>}</select><span asp-validation-for="State" class="text-danger"/></div><div class="col-md-3"><label asp-for="City" class="form-label">City <span class="text-danger">*</span></label><input asp-for="City" class="form-control" id="City" list="cityOptions" placeholder="Select or type city" required/><datalist id="cityOptions">@foreach(var x in cities){<option value="@x.CityName"></option>}</datalist><small class="text-muted">Choose a suggestion or type the city manually.</small><span asp-validation-for="City" class="text-danger d-block"/></div><div class="col-md-3"><label asp-for="PostalCode" class="form-label">Postal code <span class="text-danger">*</span></label><input asp-for="PostalCode" class="form-control" required/><span asp-validation-for="PostalCode" class="text-danger"/></div></div></div></div>
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Employment Information</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="JoiningDate" class="form-label">Joining date <span class="text-danger">*</span></label>@if(isEdit){<input type="hidden" asp-for="JoiningDate"/><input type="text" class="form-control" value="@(Model.JoiningDate?.ToString("dd-MMM-yyyy") ?? "Not available")" readonly/><small class="text-muted">Joining date is historical and cannot be changed after the employee is created.</small>}else{<input asp-for="JoiningDate" type="date" min="@today" class="form-control" required/>}<span asp-validation-for="JoiningDate" class="text-danger d-block"/></div><div class="col-md-4"><label asp-for="EmploymentType" class="form-label">Employment type <span class="text-danger">*</span></label><select asp-for="EmploymentType" class="form-select" required><option value="">Select employment type</option><option>Full-Time</option><option>Part-Time</option><option>Contract</option><option>Intern</option></select><span asp-validation-for="EmploymentType" class="text-danger"/></div></div></div></div>
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Organization &amp; Reporting</h2></div><div class="card-body"><div class="row g-3"><div class="col-md-4"><label asp-for="DepartmentID" class="form-label">Department <span class="text-danger">*</span></label><select asp-for="DepartmentID" class="form-select" required><option value="0">Select department</option>@foreach(var x in departments){<option value="@x.DepartmentID">@x.DepartmentName</option>}</select><span asp-validation-for="DepartmentID" class="text-danger"/></div><div class="col-md-4"><label asp-for="DesignationID" class="form-label">Designation <span class="text-danger">*</span></label><select asp-for="DesignationID" class="form-select" required><option value="0">Select designation</option>@foreach(var x in designations){<option value="@x.DesignationID">@x.DesignationName</option>}</select><span asp-validation-for="DesignationID" class="text-danger"/></div><div class="col-md-4"><label asp-for="OfficeLocationID" class="form-label">Office branch <span class="text-danger">*</span></label><select asp-for="OfficeLocationID" class="form-select" required><option value="0">Select office</option>@foreach(var x in offices){<option value="@x.OfficeLocationID">@x.OfficeName</option>}</select><span asp-validation-for="OfficeLocationID" class="text-danger"/></div><div class="col-md-4"><label asp-for="ManagerID" class="form-label">Manager</label><select asp-for="ManagerID" class="form-select" id="ManagerID"><option value="">None</option>@foreach(var x in managers){<option value="@x.EmployeeID">@x.FullName (@x.EmployeeCode)</option>}</select><small class="text-muted">Filtered by department and branch.</small><span asp-validation-for="ManagerID" class="text-danger"/></div><div class="col-md-4"><label asp-for="ShiftID" class="form-label">Shift</label><select asp-for="ShiftID" class="form-select"><option value="">None</option>@foreach(var x in shifts){<option value="@x.ShiftID">@x.ShiftName</option>}</select></div>@if(User.IsInRole("Admin")){<div class="col-md-4"><label asp-for="RoleID" class="form-label">System role <span class="text-danger">*</span></label><select asp-for="RoleID" class="form-select" required><option value="0">Select role</option>@foreach(var x in roles){<option value="@x.RoleID">@x.RoleName</option>}</select><span asp-validation-for="RoleID" class="text-danger"/></div>}</div></div></div>
<div class="card mb-3"><div class="card-header"><h2 class="h5 mb-0">Profile Image</h2></div><div class="card-body"><input asp-for="ProfileImageFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control"/><small class="text-muted">JPG, PNG, or WEBP up to 5 MB.</small></div></div><div class="d-flex gap-2 mb-4"><button type="submit" class="btn btn-primary">@(isEdit?"Save changes":"Create employee")</button><a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/><script>(()=>{const d=document.getElementById('DepartmentID'),o=document.getElementById('OfficeLocationID'),m=document.getElementById('ManagerID'),s=document.getElementById('State'),c=document.getElementById('City'),cityOptions=document.getElementById('cityOptions');const current='@(Model.ManagerID?.ToString()??"")';async function load(){if(!d.value||d.value==='0'||!o.value||o.value==='0')return;const r=await fetch(`@Url.Action("Managers","Employee")?departmentId=${d.value}&officeLocationId=${o.value}&excludeEmployeeId=@Model.EmployeeID`);if(!r.ok)return;const a=await r.json();m.innerHTML='<option value="">None</option>';a.forEach(x=>m.add(new Option(`${x.name} (${x.code})`,x.id,false,String(x.id)===current)));}async function loadCities(){const state=s?.value;if(!state)return;const opt=Array.from(s.options).find(x=>x.value===state);if(!opt||!opt.dataset.id)return;const r=await fetch(`@Url.Action("IndiaCities","Employee")?stateId=${opt.dataset.id}`);if(!r.ok)return;const a=await r.json();cityOptions.innerHTML='';a.forEach(x=>{const option=document.createElement('option');option.value=x.name;cityOptions.appendChild(option);});}Array.from(s?.options||[]).forEach(x=>{const stateNames=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(states.ToDictionary(x=>x.StateName??"",x=>x.StateID)));if(stateNames[x.value])x.dataset.id=stateNames[x.value];});d?.addEventListener('change',load);o?.addEventListener('change',load);s?.addEventListener('change',loadCities);if(!current)load();})();</script>}

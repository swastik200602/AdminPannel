@model AdminPannel.Models.EmployeeOnboardingModel
@{ Layout = "~/Views/Shared/_Layout.cshtml"; var employee = Model.Employee; var next = Model.Steps.FirstOrDefault(x => !x.IsComplete && !x.IsOptional && !string.IsNullOrWhiteSpace(x.ActionController)); }
<div class="app-content-header"><div class="container-fluid d-flex justify-content-between align-items-start gap-3"><div><div class="text-uppercase small text-primary fw-semibold">HR onboarding workspace</div><h1 class="fs-3 mb-1">Prepare @employee.FullName for payroll</h1><p class="text-body-secondary mb-0">Complete each setup step once. Progress is derived from the employee's live records.</p></div><a asp-action="Details" asp-route-id="@employee.EmployeeID" class="btn btn-outline-secondary"><i class="bi bi-person-vcard me-1"></i>Employee details</a></div></div>
<div class="app-content"><div class="container-fluid">
    @if (TempData["OnboardingError"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["OnboardingError"]</div> }
    @if (TempData["OnboardingMessage"] != null) { <div class="alert alert-success"><i class="bi bi-check-circle me-2"></i>@TempData["OnboardingMessage"]</div> }
    @await Html.PartialAsync("_EmployeeContextCard", new AdminPannel.Models.EmployeeContextModel { EmployeeID = employee.EmployeeID, FullName = employee.FullName, EmployeeCode = employee.EmployeeCode, ProfileImage = employee.ProfileImage, DesignationName = employee.DesignationName, DepartmentName = employee.DepartmentName, OfficeName = employee.OfficeName, JoiningDate = employee.JoiningDate, IsActive = employee.IsActive })
    <div class="card mb-3 border-primary"><div class="card-body"><div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5 mb-0">Onboarding progress</h2><span class="fw-semibold">@Model.CompletedCount / @Model.Steps.Count complete</span></div><div class="progress"><div class="progress-bar bg-primary" style="width:@(Model.Steps.Count == 0 ? 0 : Model.CompletedCount * 100 / Model.Steps.Count)%"></div></div><div class="d-flex justify-content-between align-items-center mt-3"><span class="small text-body-secondary">Progress is calculated from the employee's live records.</span>@if(next != null){<a asp-controller="@next.ActionController" asp-action="@next.ActionName" asp-route-id="@employee.EmployeeID" asp-route-employeeId="@employee.EmployeeID" class="btn btn-primary btn-sm"><i class="bi bi-arrow-right me-1"></i>@next.ActionText</a>}</div></div></div>
    <div class="row g-3">@foreach (var step in Model.Steps) { var badge = step.IsComplete ? "text-bg-success" : step.IsOptional ? "text-bg-secondary" : "text-bg-warning"; <div class="col-md-6 col-xl-4"><div class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><h2 class="h6 mb-2">@step.Title</h2><span class="badge @badge">@(step.IsComplete ? "Complete" : step.IsOptional ? "Optional" : "Missing")</span></div><p class="small text-body-secondary">@step.Description</p>@if (!string.IsNullOrWhiteSpace(step.ActionController) && !string.IsNullOrWhiteSpace(step.ActionName)) { <a asp-controller="@step.ActionController" asp-action="@step.ActionName" asp-route-id="@employee.EmployeeID" asp-route-employeeId="@employee.EmployeeID" class="btn btn-sm @(step.IsComplete ? "btn-outline-success" : "btn-primary")">@step.ActionText</a> }</div></div></div> }</div>
    @if (Model.ReadyForPayroll) { <div class="alert alert-success mt-3"><i class="bi bi-check-circle me-2"></i><strong>Employee Ready for Payroll.</strong> Required onboarding setup is complete. Payroll is not generated automatically.</div> } else { <div class="alert alert-warning mt-3"><i class="bi bi-exclamation-circle me-2"></i>Complete the missing required steps before generating payroll.</div> }
</div></div>

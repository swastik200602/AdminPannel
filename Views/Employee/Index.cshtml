@model AdminPannel.Models.EmployeePageModel
@{ ViewData["Title"] = "Employees"; var canManage = User.IsInRole("Admin") || User.IsInRole("HR"); var isEmployee = User.IsInRole("Employee"); }
    <div class="app-content-header"><div class="container-fluid"><div class="d-flex justify-content-between align-items-start gap-3"><div><div class="text-uppercase small text-primary fw-semibold">People operations</div><h1 class="fs-3 mb-1">Employee workspace</h1><p class="text-body-secondary mb-0">Create a profile, complete onboarding and prepare employees for payroll.</p></div>@if(canManage){<a asp-action="Create" class="btn btn-primary"><i class="bi bi-person-plus me-1"></i>Onboard employee</a>}</div></div></div>
<div class="app-content"><div class="container-fluid">
    @if (ViewBag.Error != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error</div> }
    @if (TempData["EmployeeError"] != null) { <div class="alert alert-danger"><i class="bi bi-exclamation-triangle me-2"></i>@TempData["EmployeeError"]</div> }
    @if (canManage) { <div class="row g-3 mb-3"><div class="col-lg-4"><div class="card h-100 border-start border-primary border-4"><div class="card-body"><div class="small text-body-secondary text-uppercase">Total employees</div><div class="fs-2 fw-semibold">@Model.TotalEmployees</div><div class="small text-body-secondary">All employee profiles in the workspace.</div></div></div></div><div class="col-lg-4"><div class="card h-100 border-start border-success border-4"><div class="card-body"><div class="small text-body-secondary text-uppercase">Active workforce</div><div class="fs-2 fw-semibold">@Model.ActiveEmployees</div><div class="small text-body-secondary">Currently active employee records.</div></div></div></div><div class="col-lg-4"><div class="card h-100 border-start border-info border-4"><div class="card-body"><div class="small text-body-secondary text-uppercase">Onboarding workspace</div><div class="fs-5 fw-semibold">Profile → setup → payroll</div><div class="small text-body-secondary">Open an employee workspace to complete every required step.</div></div></div></div></div> }
    <div class="card mb-3"><div class="card-header"><div><h2 class="h5 mb-1">Find an employee</h2><p class="small text-body-secondary mb-0">Search by identity or narrow the list by organizational context.</p></div></div><div class="card-body"><form asp-action="Index" method="get" class="row g-3 align-items-end"><div class="col-lg-4"><label asp-for="Filter.Search" class="form-label">Search employees</label><input asp-for="Filter.Search" class="form-control" placeholder="Code, name, email or phone" /></div>@if(canManage){<div class="col-lg-2"><label asp-for="Filter.DepartmentID" class="form-label">Department</label><select asp-for="Filter.DepartmentID" class="form-select"><option value="">All departments</option>@foreach(var item in Model.Departments){<option value="@item.DepartmentID">@item.DepartmentName</option>}</select></div>@if(User.IsInRole("Admin")){<div class="col-lg-2"><label asp-for="Filter.RoleID" class="form-label">Role</label><select asp-for="Filter.RoleID" class="form-select"><option value="">All roles</option>@foreach(var item in Model.Roles){<option value="@item.RoleID">@item.RoleName</option>}</select></div>}<div class="col-lg-2"><label asp-for="Filter.DesignationID" class="form-label">Designation</label><select asp-for="Filter.DesignationID" class="form-select"><option value="">All designations</option>@foreach(var item in Model.Designations){<option value="@item.DesignationID">@item.DesignationName</option>}</select></div><div class="col-lg-2"><label asp-for="Filter.OfficeLocationID" class="form-label">Office branch</label><select asp-for="Filter.OfficeLocationID" class="form-select"><option value="">All branches</option>@foreach(var item in Model.OfficeBranches){<option value="@item.OfficeLocationID">@item.OfficeName</option>}</select></div>}<div class="col-12 d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-funnel me-1"></i>Apply filters</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div></form></div></div>
    @if(isEmployee){<div class="alert alert-info"><i class="bi bi-person-check me-2"></i>This workspace is limited to your employee profile.</div>}
    <div class="card"><div class="card-header d-flex justify-content-between align-items-center"><div><h2 class="h5 mb-1">Employee directory</h2><p class="small text-body-secondary mb-0">Select an employee to view their profile or continue onboarding.</p></div><span class="badge text-bg-secondary">@Model.Employees.Count shown</span></div><div class="card-body p-0"><partial name="_EmployeeRows" model="Model.Employees" /></div></div>
</div></div>

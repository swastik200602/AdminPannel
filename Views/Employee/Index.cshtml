@model AdminPannel.Models.EmployeePageModel
@{
    ViewData["Title"] = "Employees";
    var canManage = User.IsInRole("Admin") || User.IsInRole("HR");
    var isEmployee = User.IsInRole("Employee");
}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h1 class="mb-0 fs-3">Employees</h1>
            @if (canManage)
            {
                <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Employee</a>
            }
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }
        @if (TempData["EmployeeError"] != null)
        {
            <div class="alert alert-danger">@TempData["EmployeeError"]</div>
        }
        <div class="card mb-3">
            <div class="card-body">
                <form asp-action="Index" method="get" class="row g-2">
                    <div class="col-md-4">
                        <label asp-for="Filter.Search" class="form-label">Search</label>
                        <input asp-for="Filter.Search" class="form-control" placeholder="Code, name, email or phone" />
                    </div>
                    @if (canManage)
                    {
                        <div class="col-md-2">
                            <label asp-for="Filter.DepartmentID" class="form-label">Department</label>
                            <select asp-for="Filter.DepartmentID" class="form-select">
                                <option value="">All</option>
                                @foreach (var item in Model.Departments)
                                {
                                    <option value="@item.DepartmentID">@item.DepartmentName</option>
                                }
                            </select>
                        </div>
                        @if (User.IsInRole("Admin"))
                        {
                            <div class="col-md-2">
                                <label asp-for="Filter.RoleID" class="form-label">Role</label>
                                <select asp-for="Filter.RoleID" class="form-select">
                                    <option value="">All</option>
                                    @foreach (var item in Model.Roles)
                                    {
                                        <option value="@item.RoleID">@item.RoleName</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-2">
                            <label asp-for="Filter.DesignationID" class="form-label">Designation</label>
                            <select asp-for="Filter.DesignationID" class="form-select">
                                <option value="">All</option>
                                @foreach (var item in Model.Designations)
                                {
                                    <option value="@item.DesignationID">@item.DesignationName</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label asp-for="Filter.OfficeLocationID" class="form-label">Office</label>
                            <select asp-for="Filter.OfficeLocationID" class="form-select">
                                <option value="">All</option>
                                @foreach (var item in Model.OfficeBranches)
                                {
                                    <option value="@item.OfficeLocationID">@item.OfficeName</option>
                                }
                            </select>
                        </div>
                    }
                    <div class="col-md-2 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary">Filter</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
                    </div>
                </form>
            </div>
        </div>

        @if (isEmployee)
        {
            <div class="alert alert-info">This page shows your employee profile only.</div>
        }
        <div class="card">
            <div class="card-body p-0">
                <partial name="_EmployeeRows" model="Model.Employees" />
            </div>
        </div>
    </div>
</div>
